//@version=6
indicator(title="NCI Master Indicator v0.1.2 — Candle Engine + Debug", shorttitle="NCI v0.1.2", overlay=true, max_labels_count=500, max_lines_count=100, max_boxes_count=100)

groupPreset = "01. NCI Preset Engine"
groupCandle = "02. Candle Engine Settings"
groupVisual = "03. Visual Settings"
groupDebug  = "04. Debug Mode"

presetMode = input.string(defval="Universal", title="NCI Preset", options=["Universal", "Scalping", "Day Trading", "Swing Trading", "BTCUSD", "XAUUSD", "Manual Custom"], group=groupPreset)
strictMode = input.bool(defval=true, title="Strict NCI Rules", group=groupPreset)

manualMaruRatio = input.float(defval=0.70, title="Manual Marubozu Body Ratio", minval=0.50, maxval=0.95, step=0.01, group=groupCandle)
manualSpecialMaruRatio = input.float(defval=0.55, title="Manual Special Maru Body Ratio", minval=0.40, maxval=0.90, step=0.01, group=groupCandle)
manualCloseNearExtreme = input.float(defval=0.92, title="Manual Special Maru Close Near Extreme", minval=0.70, maxval=0.99, step=0.01, group=groupCandle)
manualDojiBodyRatio = input.float(defval=0.12, title="Manual Doji Max Body Ratio", minval=0.03, maxval=0.30, step=0.01, group=groupCandle)
manualDojiMaxAtrRatio = input.float(defval=0.55, title="Manual Doji Max Range vs ATR", minval=0.10, maxval=1.50, step=0.05, group=groupCandle)
manualPinbarBodyRatio = input.float(defval=0.40, title="Manual Pinbar Max Body Ratio", minval=0.20, maxval=0.60, step=0.01, group=groupCandle)
manualPinbarWickMultiplier = input.float(defval=2.50, title="Manual Pinbar Wick / Body Multiplier", minval=1.00, maxval=5.00, step=0.10, group=groupCandle)
atrLength = input.int(defval=14, title="ATR Length", minval=5, maxval=100, group=groupCandle)
minSignificantAtrRatio = input.float(defval=0.35, title="Minimum Candle Size vs ATR", minval=0.05, maxval=2.00, step=0.05, group=groupCandle)
showCandleMarkers = input.bool(defval=true, title="Show Candle Type Markers", group=groupVisual)
showNormalCandles = input.bool(defval=false, title="Show Normal Candle Markers", group=groupVisual)
showDashboard = input.bool(defval=true, title="Show NCI Dashboard", group=groupVisual)
debugMode = input.bool(defval=true, title="Debug Mode", group=groupDebug)

float presetMaruRatio = switch presetMode
    "Universal" => 0.70
    "Scalping" => 0.70
    "Day Trading" => 0.70
    "Swing Trading" => 0.68
    "BTCUSD" => 0.70
    "XAUUSD" => 0.70
    "Manual Custom" => manualMaruRatio

float presetSpecialMaruRatio = switch presetMode
    "Universal" => 0.55
    "Scalping" => 0.56
    "Day Trading" => 0.55
    "Swing Trading" => 0.55
    "BTCUSD" => 0.56
    "XAUUSD" => 0.55
    "Manual Custom" => manualSpecialMaruRatio

float presetCloseNearExtreme = switch presetMode
    "Universal" => 0.92
    "Scalping" => 0.93
    "Day Trading" => 0.92
    "Swing Trading" => 0.90
    "BTCUSD" => 0.93
    "XAUUSD" => 0.92
    "Manual Custom" => manualCloseNearExtreme

float presetDojiBodyRatio = switch presetMode
    "Universal" => 0.12
    "Scalping" => 0.10
    "Day Trading" => 0.12
    "Swing Trading" => 0.15
    "BTCUSD" => 0.10
    "XAUUSD" => 0.12
    "Manual Custom" => manualDojiBodyRatio

float presetDojiMaxAtrRatio = switch presetMode
    "Universal" => 0.55
    "Scalping" => 0.50
    "Day Trading" => 0.55
    "Swing Trading" => 0.65
    "BTCUSD" => 0.55
    "XAUUSD" => 0.55
    "Manual Custom" => manualDojiMaxAtrRatio

float presetPinbarBodyRatio = switch presetMode
    "Universal" => 0.40
    "Scalping" => 0.38
    "Day Trading" => 0.40
    "Swing Trading" => 0.45
    "BTCUSD" => 0.38
    "XAUUSD" => 0.40
    "Manual Custom" => manualPinbarBodyRatio

float presetPinbarWickMultiplier = switch presetMode
    "Universal" => 2.50
    "Scalping" => 2.70
    "Day Trading" => 2.50
    "Swing Trading" => 2.20
    "BTCUSD" => 2.80
    "XAUUSD" => 2.50
    "Manual Custom" => manualPinbarWickMultiplier

maruRatio = strictMode ? math.max(presetMaruRatio, 0.70) : presetMaruRatio
specialMaruRatio = strictMode ? math.max(presetSpecialMaruRatio, 0.55) : presetSpecialMaruRatio
closeNearExtreme = strictMode ? math.max(presetCloseNearExtreme, 0.92) : presetCloseNearExtreme
dojiBodyRatio = strictMode ? math.min(presetDojiBodyRatio, 0.12) : presetDojiBodyRatio
dojiMaxAtrRatio = strictMode ? math.min(presetDojiMaxAtrRatio, 0.55) : presetDojiMaxAtrRatio
pinbarBodyRatio = strictMode ? math.min(presetPinbarBodyRatio, 0.40) : presetPinbarBodyRatio
pinbarWickMultiple = strictMode ? math.max(presetPinbarWickMultiplier, 2.50) : presetPinbarWickMultiplier
specialDominantWickVsBody = presetMode == "BTCUSD" ? 0.35 : 0.30
specialDominantWickVsOpposite = presetMode == "BTCUSD" ? 1.50 : 1.30

candleRange = high - low
bodySize = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
bodyRatio = candleRange > 0 ? bodySize / candleRange : 0.0
closePosition = candleRange > 0 ? (close - low) / candleRange : 0.5
atrValue = ta.atr(atrLength)
rangeAtrRatio = atrValue > 0 ? candleRange / atrValue : 0.0
isSignificantCandle = candleRange >= atrValue * minSignificantAtrRatio
isBull = close > open
isBear = close < open

isBullMaru = isSignificantCandle and isBull and bodyRatio >= maruRatio
isBearMaru = isSignificantCandle and isBear and bodyRatio >= maruRatio
isMaru = isBullMaru or isBearMaru

isDoji = bodyRatio <= dojiBodyRatio and rangeAtrRatio <= dojiMaxAtrRatio

bullSpecialWickOK = lowerWick >= bodySize * specialDominantWickVsBody and lowerWick >= upperWick * specialDominantWickVsOpposite
bearSpecialWickOK = upperWick >= bodySize * specialDominantWickVsBody and upperWick >= lowerWick * specialDominantWickVsOpposite
isBullSpecialMaru = not isMaru and not isDoji and isSignificantCandle and isBull and bodyRatio >= specialMaruRatio and closePosition >= closeNearExtreme and bullSpecialWickOK
isBearSpecialMaru = not isMaru and not isDoji and isSignificantCandle and isBear and bodyRatio >= specialMaruRatio and closePosition <= 1.0 - closeNearExtreme and bearSpecialWickOK
isSpecialMaru = isBullSpecialMaru or isBearSpecialMaru

hasBullishPinWick = lowerWick >= bodySize * pinbarWickMultiple and lowerWick > upperWick
hasBearishPinWick = upperWick >= bodySize * pinbarWickMultiple and upperWick > lowerWick
isBullPinbar = not isDoji and not isMaru and not isSpecialMaru and isSignificantCandle and bodyRatio < pinbarBodyRatio and hasBullishPinWick
isBearPinbar = not isDoji and not isMaru and not isSpecialMaru and isSignificantCandle and bodyRatio < pinbarBodyRatio and hasBearishPinWick
isPinbar = isBullPinbar or isBearPinbar
isNormalCandle = not isMaru and not isDoji and not isSpecialMaru and not isPinbar

string candleClass = isBullMaru ? "Bull Maru" : isBearMaru ? "Bear Maru" : isDoji ? "Doji" : isBullSpecialMaru ? "Bull Special Maru" : isBearSpecialMaru ? "Bear Special Maru" : isBullPinbar ? "Bull Pinbar" : isBearPinbar ? "Bear Pinbar" : "Normal"

plotshape(showCandleMarkers and isBullMaru, title="NCI Bull Maru", style=shape.triangleup, location=location.belowbar, text="M+", size=size.tiny, color=color.new(color.green, 0), textcolor=color.white)
plotshape(showCandleMarkers and isBearMaru, title="NCI Bear Maru", style=shape.triangledown, location=location.abovebar, text="M-", size=size.tiny, color=color.new(color.red, 0), textcolor=color.white)
plotshape(showCandleMarkers and isDoji, title="NCI Doji", style=shape.xcross, location=location.abovebar, text="DJ", size=size.tiny, color=color.new(color.gray, 0), textcolor=color.white)
plotshape(showCandleMarkers and isBullSpecialMaru, title="NCI Bull Special Maru", style=shape.labelup, location=location.belowbar, text="SM+", size=size.tiny, color=color.new(color.lime, 0), textcolor=color.black)
plotshape(showCandleMarkers and isBearSpecialMaru, title="NCI Bear Special Maru", style=shape.labeldown, location=location.abovebar, text="SM-", size=size.tiny, color=color.new(color.maroon, 0), textcolor=color.white)
plotshape(showCandleMarkers and isBullPinbar, title="NCI Bull Pinbar", style=shape.circle, location=location.belowbar, text="PB+", size=size.tiny, color=color.new(color.blue, 0), textcolor=color.white)
plotshape(showCandleMarkers and isBearPinbar, title="NCI Bear Pinbar", style=shape.circle, location=location.abovebar, text="PB-", size=size.tiny, color=color.new(color.orange, 0), textcolor=color.black)
plotshape(showCandleMarkers and showNormalCandles and isNormalCandle, title="NCI Normal Candle", style=shape.square, location=location.bottom, text="N", size=size.tiny, color=color.new(color.black, 70), textcolor=color.white)

var table dash = table.new(position.top_right, 2, 15, border_width=1)
f_boolText(_condition) => _condition ? "PASS" : "FAIL"
f_boolColor(_condition) => _condition ? color.new(color.green, 20) : color.new(color.red, 20)
if barstate.islast and showDashboard
    table.cell(dash, 0, 0, "NCI v0.1.2", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 0, "Candle Engine", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 0, 1, "Preset", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 1, presetMode, text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 0, 2, "Strict", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 2, strictMode ? "ON" : "OFF", text_color=color.white, bgcolor=strictMode ? color.new(color.green, 20) : color.new(color.orange, 20))
    table.cell(dash, 0, 3, "Class", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 3, candleClass, text_color=color.white, bgcolor=color.new(color.blue, 65))
    table.cell(dash, 0, 4, "Body Ratio", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 4, str.tostring(bodyRatio * 100, "#.##") + "%", text_color=color.white, bgcolor=color.new(color.gray, 80))
    table.cell(dash, 0, 5, "Close Pos", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 5, str.tostring(closePosition * 100, "#.##") + "%", text_color=color.white, bgcolor=color.new(color.gray, 80))
    table.cell(dash, 0, 6, "Range/ATR", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 6, str.tostring(rangeAtrRatio, "#.##") + "x", text_color=color.white, bgcolor=color.new(color.gray, 80))
    table.cell(dash, 0, 7, "Maru", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 7, f_boolText(isMaru), text_color=color.white, bgcolor=f_boolColor(isMaru))
    table.cell(dash, 0, 8, "Doji", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 8, f_boolText(isDoji), text_color=color.white, bgcolor=f_boolColor(isDoji))
    table.cell(dash, 0, 9, "Special Maru", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 9, f_boolText(isSpecialMaru), text_color=color.white, bgcolor=f_boolColor(isSpecialMaru))
    table.cell(dash, 0, 10, "Pinbar", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 10, f_boolText(isPinbar), text_color=color.white, bgcolor=f_boolColor(isPinbar))
    table.cell(dash, 0, 11, "Significant", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 11, f_boolText(isSignificantCandle), text_color=color.white, bgcolor=f_boolColor(isSignificantCandle))
    table.cell(dash, 0, 12, "Maru Thresh", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 12, str.tostring(maruRatio * 100, "#.##") + "%", text_color=color.white, bgcolor=color.new(color.gray, 80))
    table.cell(dash, 0, 13, "Doji Thresh", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 13, str.tostring(dojiBodyRatio * 100, "#.##") + "%", text_color=color.white, bgcolor=color.new(color.gray, 80))
    table.cell(dash, 0, 14, "PB Wick", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 14, str.tostring(pinbarWickMultiple, "#.##") + "x body", text_color=color.white, bgcolor=color.new(color.gray, 80))

alertcondition(isBullMaru, title="NCI Bull Maru", message="NCI Bull Maru candle detected.")
alertcondition(isBearMaru, title="NCI Bear Maru", message="NCI Bear Maru candle detected.")
alertcondition(isDoji, title="NCI Doji", message="NCI Doji candle detected.")
alertcondition(isBullSpecialMaru, title="NCI Bull Special Maru", message="NCI Bull Special Maru candle detected.")
alertcondition(isBearSpecialMaru, title="NCI Bear Special Maru", message="NCI Bear Special Maru candle detected.")
alertcondition(isBullPinbar, title="NCI Bull Pinbar", message="NCI Bull Pinbar candle detected.")
alertcondition(isBearPinbar, title="NCI Bear Pinbar", message="NCI Bear Pinbar candle detected.")
