//@version=6
indicator(title="NCI v0.2.1 Block — Structure Line + KL Boxes", shorttitle="NCI v021", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=200)

//=============================================================================
// NCI v0.2.1 SCRIPT BLOCK — STRUCTURE LINE + KEY LEVEL BOX VISUAL ENGINE
//=============================================================================
// Purpose:
// - Stop noisy normal-mode PBW/PW labels.
// - Draw clean NCI-style market-cycle structure lines.
// - Draw KL UP / KL DOWN rectangle boxes with timeframe detail.
// - Draw broken KL box when key level is broken.
// - Keep raw wave labels available only in Debug Mode.
//
// IMPORTANT:
// - This is a visual framework block.
// - It is designed to match Ravi's manual drawing style first.
// - Final turning points must later be validated with strict NCI PW/PBW logic.
//=============================================================================

//=============================================================================
// 1. INPUTS
//=============================================================================

groupCycle = "01. Market Cycle / Structure"
groupVisual = "02. Visual Style"
groupDebug = "03. Debug"

analysisTfLabel = input.string("Auto", "Displayed TF Label", options=["Auto", "H4", "H1", "M15", "M5"], group=groupCycle)
pivotLen = input.int(5, "Structure Turning Point Strength", minval=2, maxval=30, group=groupCycle)
minLegAtr = input.float(1.20, "Minimum Structure Leg Size vs ATR", minval=0.20, maxval=10.00, step=0.10, group=groupCycle)
atrLength = input.int(14, "ATR Length", minval=5, maxval=100, group=groupCycle)
klBoxBars = input.int(120, "KL Box Extension Bars", minval=20, maxval=500, group=groupCycle)
klBoxHeightAtr = input.float(0.18, "KL Box Height vs ATR", minval=0.03, maxval=2.00, step=0.01, group=groupCycle)
showOnlyLatestKL = input.bool(true, "Show Only Latest Active KL", group=groupCycle)

showStructureLine = input.bool(true, "Show Market Cycle Structure Line", group=groupVisual)
showKLBoxes = input.bool(true, "Show KL Boxes", group=groupVisual)
showBrokenKL = input.bool(true, "Show Broken KL Box", group=groupVisual)
showDashboard = input.bool(true, "Show Dashboard", group=groupVisual)
structureLineWidth = input.int(3, "Structure Line Width", minval=1, maxval=5, group=groupVisual)

debugMode = input.bool(false, "Debug Mode — Show Raw Structure Events", group=groupDebug)
showRawPivots = input.bool(false, "Debug: Show Raw Turning Points", group=groupDebug)

//=============================================================================
// 2. TIMEFRAME LABEL
//=============================================================================

f_autoTfLabel() =>
    timeframe.period == "240" ? "H4" :
     timeframe.period == "60" ? "H1" :
     timeframe.period == "15" ? "M15" :
     timeframe.period == "5" ? "M5" :
     timeframe.period

string tfLabel = analysisTfLabel == "Auto" ? f_autoTfLabel() : analysisTfLabel

//=============================================================================
// 3. BASIC STRUCTURE POINT DETECTION
//=============================================================================

atrValue = ta.atr(atrLength)
pivH = ta.pivothigh(high, pivotLen, pivotLen)
pivL = ta.pivotlow(low, pivotLen, pivotLen)

var float lastPointPrice = na
var int lastPointIndex = na
var int lastPointType = 0
var string cycleState = "WAIT"
var string activeDirection = "NONE"

var array<line> structureLines = array.new_line()

var box activeKLBox = na
var label activeKLLabel = na
var box brokenKLBox = na
var label brokenKLLabel = na

var float activeKLTop = na
var float activeKLBottom = na
var string activeKLDirection = "NONE"
var string lastBrokenText = "None"

newHigh = not na(pivH)
newLow = not na(pivL)
newPointIndexHigh = bar_index - pivotLen
newPointIndexLow = bar_index - pivotLen

plotshape(debugMode and showRawPivots and newHigh, title="Raw Structure High", style=shape.triangledown, location=location.abovebar, offset=-pivotLen, text="SH", size=size.tiny, color=color.new(color.orange, 0), textcolor=color.black)
plotshape(debugMode and showRawPivots and newLow, title="Raw Structure Low", style=shape.triangleup, location=location.belowbar, offset=-pivotLen, text="SL", size=size.tiny, color=color.new(color.aqua, 0), textcolor=color.black)

//=============================================================================
// 4. HELPER LOGIC
//=============================================================================

f_validLeg(_newPrice) =>
    na(lastPointPrice) or math.abs(_newPrice - lastPointPrice) >= atrValue * minLegAtr

f_addStructureLine(_x1, _y1, _x2, _y2) =>
    if showStructureLine and not na(_x1) and not na(_y1)
        line newLine = line.new(_x1, _y1, _x2, _y2, xloc=xloc.bar_index, extend=extend.none, color=color.new(color.teal, 0), width=structureLineWidth)
        array.push(structureLines, newLine)
        if array.size(structureLines) > 20
            line.delete(array.shift(structureLines))

f_stateBg(_state) =>
    str.contains(_state, "UP") and not str.contains(_state, "BROKEN") ? color.new(color.green, 25) :
     str.contains(_state, "DOWN") and not str.contains(_state, "BROKEN") ? color.new(color.red, 25) :
     str.contains(_state, "BROKEN") ? color.new(color.orange, 25) : color.new(color.gray, 75)

//=============================================================================
// 5. STRUCTURE LINE + MARKET CYCLE STATE UPDATE
//=============================================================================

if newHigh and f_validLeg(pivH)
    if lastPointType != 1
        f_addStructureLine(lastPointIndex, lastPointPrice, newPointIndexHigh, pivH)

        if lastPointType == -1
            cycleState := "UP CYCLE"
            activeDirection := "UP"

            if showKLBoxes and not na(lastPointPrice)
                if showOnlyLatestKL
                    box.delete(activeKLBox)
                    label.delete(activeKLLabel)

                float boxHeightUp = atrValue * klBoxHeightAtr
                activeKLTop := lastPointPrice + boxHeightUp
                activeKLBottom := lastPointPrice - boxHeightUp
                activeKLDirection := "UP"

                activeKLBox := box.new(left=lastPointIndex, top=activeKLTop, right=bar_index + klBoxBars, bottom=activeKLBottom, xloc=xloc.bar_index, bgcolor=color.new(color.aqua, 84), border_color=color.new(color.teal, 0), border_width=2)
                activeKLLabel := label.new(bar_index + math.min(klBoxBars, 50), (activeKLTop + activeKLBottom) / 2.0, tfLabel + " KL UP", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.aqua, 78), textcolor=color.black, size=size.small)

        lastPointPrice := pivH
        lastPointIndex := newPointIndexHigh
        lastPointType := 1

if newLow and f_validLeg(pivL)
    if lastPointType != -1
        f_addStructureLine(lastPointIndex, lastPointPrice, newPointIndexLow, pivL)

        if lastPointType == 1
            cycleState := "DOWN CYCLE"
            activeDirection := "DOWN"

            if showKLBoxes and not na(lastPointPrice)
                if showOnlyLatestKL
                    box.delete(activeKLBox)
                    label.delete(activeKLLabel)

                float boxHeightDown = atrValue * klBoxHeightAtr
                activeKLTop := lastPointPrice + boxHeightDown
                activeKLBottom := lastPointPrice - boxHeightDown
                activeKLDirection := "DOWN"

                activeKLBox := box.new(left=lastPointIndex, top=activeKLTop, right=bar_index + klBoxBars, bottom=activeKLBottom, xloc=xloc.bar_index, bgcolor=color.new(color.fuchsia, 86), border_color=color.new(color.rgb(255, 105, 180), 0), border_width=2)
                activeKLLabel := label.new(bar_index + math.min(klBoxBars, 50), (activeKLTop + activeKLBottom) / 2.0, tfLabel + " KL DOWN", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.rgb(255, 105, 180), 78), textcolor=color.black, size=size.small)

        lastPointPrice := pivL
        lastPointIndex := newPointIndexLow
        lastPointType := -1

//=============================================================================
// 6. BROKEN KL VISUAL
//=============================================================================

upKLBroken = showBrokenKL and activeKLDirection == "UP" and not na(activeKLBottom) and close < activeKLBottom
downKLBroken = showBrokenKL and activeKLDirection == "DOWN" and not na(activeKLTop) and close > activeKLTop

if upKLBroken or downKLBroken
    box.delete(brokenKLBox)
    label.delete(brokenKLLabel)

    brokenKLBox := box.new(left=bar_index - pivotLen, top=activeKLTop, right=bar_index + math.min(klBoxBars, 60), bottom=activeKLBottom, xloc=xloc.bar_index, bgcolor=color.new(color.orange, 86), border_color=color.new(color.orange, 0), border_width=2)
    lastBrokenText := "KL " + tfLabel + " Broken"
    brokenKLLabel := label.new(bar_index, (activeKLTop + activeKLBottom) / 2.0, lastBrokenText, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.orange, 78), textcolor=color.black, size=size.small)

    activeKLDirection := "BROKEN"
    cycleState := activeDirection == "UP" ? "UP KL BROKEN" : activeDirection == "DOWN" ? "DOWN KL BROKEN" : "KL BROKEN"

//=============================================================================
// 7. DASHBOARD
//=============================================================================

var table dash = table.new(position.top_right, 2, 7, border_width=1)

if barstate.islast and showDashboard
    table.cell(dash, 0, 0, "NCI v0.2.1", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 0, "Visual MS + KL", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 0, 1, "TF", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 1, tfLabel, text_color=color.white, bgcolor=color.new(color.gray, 75))
    table.cell(dash, 0, 2, "Market Cycle", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 2, cycleState, text_color=color.white, bgcolor=f_stateBg(cycleState))
    table.cell(dash, 0, 3, "Active KL", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 3, activeKLDirection, text_color=color.white, bgcolor=f_stateBg(activeKLDirection))
    table.cell(dash, 0, 4, "Broken", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 4, lastBrokenText, text_color=color.white, bgcolor=str.contains(lastBrokenText, "Broken") ? color.new(color.orange, 25) : color.new(color.gray, 80))
    table.cell(dash, 0, 5, "Display", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 5, debugMode ? "DEBUG" : "NORMAL", text_color=color.white, bgcolor=debugMode ? color.new(color.orange, 25) : color.new(color.green, 35))
    table.cell(dash, 0, 6, "Rule", text_color=color.white, bgcolor=color.new(color.gray, 70))
    table.cell(dash, 1, 6, "Cycle → KL Box", text_color=color.white, bgcolor=color.new(color.blue, 70))

//=============================================================================
// 8. ALERTS
//=============================================================================

alertcondition(upKLBroken, title="NCI KL UP Broken Visual", message="NCI visual KL UP broken. Validate with NCI breakout standard.")
alertcondition(downKLBroken, title="NCI KL DOWN Broken Visual", message="NCI visual KL DOWN broken. Validate with NCI breakout standard.")

// END OF NCI v0.2.1 VISUAL STRUCTURE + KL BOX BLOCK
