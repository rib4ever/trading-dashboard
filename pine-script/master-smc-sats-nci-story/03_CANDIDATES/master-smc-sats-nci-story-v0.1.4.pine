//@version=6
// ══════════════════════════════════════════════════════════════════════════════
// MASTER SMC + SATS SNIPER SYSTEM [Ravi Custom 01]
// ══════════════════════════════════════════════════════════════════════════════
// MASTER SMC + SATS + NCI STORY CANDIDATE v0.1.4
// Base: existing SMC/SATS engine.
// Added: NCI story layer + Three-OK dashboard alerts.
// Three-OK BUY  = HTF POI Buy OK + Exec Zone Buy OK + Key Touch Buy OK.
// Three-OK SELL = HTF POI Sell OK + Exec Zone Sell OK + Key Touch Sell OK.
// Safety rule: no entry, risk, SATS, OB/FVG drawing, or liquidity logic changes.
// ══════════════════════════════════════════════════════════════════════════════

// Rebuild Version: v1.3
// Built from:
// 1) Flux Charts style Market Structure / OB / FVG / Sweep logic
// 2) WillyAlgoTrader SATS adaptive trend-quality logic
// 3) Ravi Custom sniper-entry confluence rules
//
// Core rule:
// No random entries. Entry logic must require:
// - Existing key-level touch / reaction
// - HTF OB/FVG context
// - Liquidity sweep / reclaim confirmation
// - Execution OB/FVG or structure confirmation
// - SATS trend-quality confirmation with TQI / ER filters
// ══════════════════════════════════════════════════════════════════════════════

indicator(
     title = "Master SMC + SATS Sniper System [Ravi Custom 01]",
     shorttitle = "SMC_SATS",
     overlay = true,
     max_boxes_count = 500,
     max_labels_count = 500,
     max_lines_count = 500,
     max_bars_back = 5000)

// ══════════════════════════════════════════════════════════════════════════════
// ══════════════════════════════════════════════════════════════════════════════
// ══════════════════════════════════════════════════════════════════════════════
// v1.7 SETTINGS UI CLEANUP CANDIDATE NOTE
// Built from v1.6 candidate.
// This pass reorganizes TradingView settings groups and labels only.
// It should not change entry logic, SMC logic, SATS logic, risk logic, or alerts.
// Test in TradingView before promotion.
// ══════════════════════════════════════════════════════════════════════════════

// v1.6 THEME ENGINE CANDIDATE NOTE
// Built from v1.5 candidate plus 09a_theme_engine.pine.
// Theme engine changes visual colors only and should not affect entry logic.
// Test in TradingView before promotion to compiled master.
// ══════════════════════════════════════════════════════════════════════════════

// v1.5 CANDIDATE NOTE
// Built from protected v1.4 base plus isolated smart key-level and entry workflow blocks.
// Smart levels are selectable from current chart / HTF1 / HTF2.
// Entry workflow can run as Market Structure Only, Setups Only, Opportunity Mode,
// Confirmed Entries, Full Mode, or Manual Custom.
// Mini status panel has selectable placement.
// Test in TradingView before promotion to compiled master.
// ══════════════════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════════════════
// GROUPS
// ══════════════════════════════════════════════════════════════════════════════
GRP_MASTER = "01 Quick Start / Master Preset"
GRP_SMC    = "05 SMC Engine / Bias Timeframes"
GRP_SATS   = "06 SATS Trend Quality Engine"
GRP_RISK   = "10 Risk / TP / SL"
GRP_VIS    = "09 Visual Display"
GRP_HTFLVL = "07 HTF Key Levels"
GRP_ALERT  = "11 Alerts"
GRP_COL    = "🎨 Colors"

// ══════════════════════════════════════════════════════════════════════════════
// COLORS
// ══════════════════════════════════════════════════════════════════════════════
// Theme Engine Block for v1.6
// This block is not standalone. It must be injected into the master script.
// It intentionally keeps existing variable names used by the base script:
// bullColor, bearColor, neutColor, slColor, tpColor.

GRP_THEME = "02 Theme Engine / Chart Colors"

BULL_DEFAULT = #089981
BEAR_DEFAULT = #f23645
NEUT_DEFAULT = #b8b8b8
ORANGE       = #f97316
YELLOW       = #fbbf24
HIT_COLOR    = #40E0D0

themePreset = input.string(
     "Night Phantom",
     "Theme Preset",
     options = [
         "Claude",
         "Onyx",
         "Bone",
         "Lavender",
         "Arctic",
         "Night",
         "ICT V2",
         "Glass",
         "Bone Luxe",
         "Lavender Mist",
         "Arctic Frost",
         "Night Phantom",
         "Onyx Gold",
         "Diamond Ice",
         "Forest Temple",
         "Ember Smoke",
         "Ocean Glass",
         "Royal Burgundy",
         "Crystal",
         "Diamond",
         "Earthy",
         "Nature",
         "Midnight Pro",
         "Gold Trader",
         "Cyber Neon",
         "Manual Custom"
     ],
     group = GRP_THEME)

themeIntensity = input.string(
     "Standard",
     "Theme Intensity",
     options = ["Soft", "Standard", "Strong"],
     group = GRP_THEME)

themeZoneTransparency = input.int(68, "Zone Transparency", minval = 20, maxval = 90, group = GRP_THEME, tooltip = "Lower value = stronger OB/FVG zones. Higher value = lighter zones. Default was reduced so light themes do not disappear.")
themePanelTransparency = input.int(20, "Panel Transparency", minval = 0, maxval = 95, group = GRP_THEME)

manualBullColor = input.color(BULL_DEFAULT, "Manual Theme Bull", inline = "tm1", group = GRP_THEME)
manualBearColor = input.color(BEAR_DEFAULT, "Manual Theme Bear", inline = "tm1", group = GRP_THEME)
manualNeutColor = input.color(NEUT_DEFAULT, "Manual Theme Neutral", inline = "tm2", group = GRP_THEME)
manualSlColor   = input.color(#FF1744, "Manual Theme SL", inline = "tm3", group = GRP_THEME)
manualTpColor   = input.color(#00E676, "Manual Theme TP", inline = "tm3", group = GRP_THEME)

// Collection-style chart themes inspired by Ravi's reference palettes.
// Note: TradingView script cannot change the chart background itself from an indicator.
// The background values are kept as reference colors for panels and future documentation.
color themeBackgroundRef = switch themePreset
    "Claude"          => #1f1c19
    "Onyx"            => #121212
    "Bone"            => #e4e0d6
    "Lavender"        => #f4effb
    "Arctic"          => #f1f6fb
    "Night"           => #0b1220
    "ICT V2"          => #f3f1ec
    "Glass"           => #12161c
    "Bone Luxe"       => #ded7c8
    "Lavender Mist"   => #f0e8f8
    "Arctic Frost"    => #edf6fb
    "Night Phantom"   => #070d18
    "Onyx Gold"       => #0d0c0a
    "Diamond Ice"     => #08141b
    "Forest Temple"   => #101a13
    "Ember Smoke"     => #18110e
    "Ocean Glass"     => #071b20
    "Royal Burgundy"  => #180911
    "Manual Custom"   => color.black
    => color.black

bool themeIsLight = themePreset == "Bone" or themePreset == "Lavender" or themePreset == "Arctic" or themePreset == "ICT V2" or themePreset == "Bone Luxe" or themePreset == "Lavender Mist" or themePreset == "Arctic Frost"

color themeBaseBull = switch themePreset
    "Claude"          => #d38a5d
    "Onyx"            => #c8b89a
    "Bone"            => #f7f4ed
    "Lavender"        => #ffffff
    "Arctic"          => #ffffff
    "Night"           => #c7e2f7
    "ICT V2"          => #6b8f7a
    "Glass"           => #9fded2
