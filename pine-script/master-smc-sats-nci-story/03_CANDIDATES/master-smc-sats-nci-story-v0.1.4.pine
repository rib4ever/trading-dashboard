    "Ember Smoke"     => #5e4b43
    "Ocean Glass"     => #526d75
    "Royal Burgundy"  => #7a364f
    "Onyx"            => #7a7368
    "Claude"          => #7e7a75
    "Glass"           => #9ba7b2
    => themeBaseBear

color themeBaseSL = switch themePreset
    "Claude" => #b96a4d
    "Onyx" => #8f6f5f
    "Bone" => #6f6b63
    "Lavender" => #7a6285
    "Arctic" => #8aa8bc
    "Night" => #5a6472
