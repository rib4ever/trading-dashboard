// NCI SMART VALIDATION ENHANCER v0.1.5
GRP_NCI_V15 = "15 NCI Smart Validation v0.1.5"
nciV15Mode = input.string("Smart", "Validation Mode", options=["Off","Light","Smart","Strict"], group=GRP_NCI_V15)
nciV15MinScore = input.int(7, "Minimum Smart Score", minval=1, maxval=12, group=GRP_NCI_V15)
nciV15StrictScore = input.int(9, "Strict Score", minval=1, maxval=12, group=GRP_NCI_V15)
nciV15RequireBase = input.bool(true, "Require Three Dashboard Checks", group=GRP_NCI_V15)
nciV15RequireHtf = input.bool(true, "Require HTF Bias", group=GRP_NCI_V15)
nciV15RequireBody = input.bool(true, "Require Candle Close Confirmation", group=GRP_NCI_V15)
nciV15RequireSweep = input.bool(false, "Require Sweep", group=GRP_NCI_V15)
nciV15RequireImpulse = input.bool(false, "Require Impulse/FVG", group=GRP_NCI_V15)
nciV15UseSats = input.bool(true, "Use SATS Quality", group=GRP_NCI_V15)
nciV15VisualMode = input.string("Compact", "Visual Mode", options=["Off","Compact","Full","Debug"], group=GRP_NCI_V15)
nciV15AtrLen = input.int(14, "ATR Length", minval=3, maxval=100, group=GRP_NCI_V15)
nciV15SweepLen = input.int(20, "Sweep Lookback", minval=3, maxval=100, group=GRP_NCI_V15)
nciV15ImpulseAtr = input.float(1.0, "Impulse ATR Multiple", minval=0.1, maxval=5.0, step=0.1, group=GRP_NCI_V15)
nciV15Cooldown = input.int(10, "Signal Cooldown", minval=0, maxval=500, group=GRP_NCI_V15)
nciV15ShowLabels = input.bool(true, "Show Smart Labels", group=GRP_NCI_V15)

nciV15Atr = ta.atr(nciV15AtrLen)
nciV15Range = math.max(high-low, syminfo.mintick)
nciV15BodyRatio = math.abs(close-open)/nciV15Range
nciV15BullCandle = close > open and close > high - nciV15Range*0.25
nciV15BearCandle = close < open and close < low + nciV15Range*0.25
nciV15BullMaru = close > open and nciV15BodyRatio >= 0.60
nciV15BearMaru = close < open and nciV15BodyRatio >= 0.60
nciV15BullImpulse = nciV15BullMaru and nciV15Range >= nciV15Atr*nciV15ImpulseAtr
nciV15BearImpulse = nciV15BearMaru and nciV15Range >= nciV15Atr*nciV15ImpulseAtr
nciV15BullFvg = low > high[2] and nciV15BullImpulse
nciV15BearFvg = high < low[2] and nciV15BearImpulse
nciV15SellSideSweep = low < ta.lowest(low[1], nciV15SweepLen) and close > low
nciV15BuySideSweep = high > ta.highest(high[1], nciV15SweepLen) and close < high
nciV15ThreeBuy = htfBullPoiContext and executionBullZoneOk and bullKeyReaction
nciV15ThreeSell = htfBearPoiContext and executionBearZoneOk and bearKeyReaction
nciV15SatsOk = not nciV15UseSats or (tqi >= effectiveMinTqi and erValue >= effectiveMinEr)
nciV15BuyScore = (nciV15ThreeBuy ? 3 : 0) + (htfBullishBias ? 1 : 0) + ((nciV15BullCandle or nciV15BullMaru) ? 1 : 0) + ((sweepOkBuy or nciV15SellSideSweep) ? 1 : 0) + ((nciV15BullImpulse or nciV15BullFvg) ? 1 : 0) + (nciV15SatsOk ? 1 : 0) + (killzoneAllowed ? 1 : 0) + ((bullSniperEntry or normalBullEntry or keyLevelBullEntry or bullOpportunityEntry) ? 1 : 0)
nciV15SellScore = (nciV15ThreeSell ? 3 : 0) + (htfBearishBias ? 1 : 0) + ((nciV15BearCandle or nciV15BearMaru) ? 1 : 0) + ((sweepOkSell or nciV15BuySideSweep) ? 1 : 0) + ((nciV15BearImpulse or nciV15BearFvg) ? 1 : 0) + (nciV15SatsOk ? 1 : 0) + (killzoneAllowed ? 1 : 0) + ((bearSniperEntry or normalBearEntry or keyLevelBearEntry or bearOpportunityEntry) ? 1 : 0)
nciV15Min = nciV15Mode == "Strict" ? nciV15StrictScore : nciV15MinScore
nciV15BaseBuyOk = not nciV15RequireBase or nciV15ThreeBuy
nciV15BaseSellOk = not nciV15RequireBase or nciV15ThreeSell
nciV15BuyOk = nciV15Mode != "Off" and nciV15BaseBuyOk and (not nciV15RequireHtf or htfBullishBias) and (not nciV15RequireBody or nciV15BullCandle or nciV15BullMaru) and (not nciV15RequireSweep or sweepOkBuy or nciV15SellSideSweep) and (not nciV15RequireImpulse or nciV15BullImpulse or nciV15BullFvg) and nciV15SatsOk and nciV15BuyScore >= nciV15Min
nciV15SellOk = nciV15Mode != "Off" and nciV15BaseSellOk and (not nciV15RequireHtf or htfBearishBias) and (not nciV15RequireBody or nciV15BearCandle or nciV15BearMaru) and (not nciV15RequireSweep or sweepOkSell or nciV15BuySideSweep) and (not nciV15RequireImpulse or nciV15BearImpulse or nciV15BearFvg) and nciV15SatsOk and nciV15SellScore >= nciV15Min
var int nciV15LastBuy = na
var int nciV15LastSell = na
nciV15BuySignal = nciV15BuyOk and barstate.isconfirmed and (na(nciV15LastBuy) or bar_index - nciV15LastBuy > nciV15Cooldown)
nciV15SellSignal = nciV15SellOk and barstate.isconfirmed and (na(nciV15LastSell) or bar_index - nciV15LastSell > nciV15Cooldown)
if nciV15BuySignal
    nciV15LastBuy := bar_index
if nciV15SellSignal
    nciV15LastSell := bar_index
nciV15Grade(int s) => s >= 10 ? "A+" : s >= 8 ? "A" : s >= 6 ? "B" : "WAIT"
alertcondition(nciV15BuySignal, title="NCI v0.1.5 Validated BUY", message="NCI v0.1.5 Validated BUY")
alertcondition(nciV15SellSignal, title="NCI v0.1.5 Validated SELL", message="NCI v0.1.5 Validated SELL")
if nciV15VisualMode != "Off" and nciV15ShowLabels and nciV15BuySignal
    label.new(bar_index, low-nciV15Atr, "VALID BUY\n" + str.tostring(nciV15BuyScore) + "/12 " + nciV15Grade(nciV15BuyScore), style=label.style_label_up, color=color.new(bullColor,0), textcolor=color.white, size=size.small)
if nciV15VisualMode != "Off" and nciV15ShowLabels and nciV15SellSignal
    label.new(bar_index, high+nciV15Atr, "VALID SELL\n" + str.tostring(nciV15SellScore) + "/12 " + nciV15Grade(nciV15SellScore), style=label.style_label_down, color=color.new(bearColor,0), textcolor=color.white, size=size.small)
plotshape((nciV15VisualMode == "Full" or nciV15VisualMode == "Debug") and nciV15BullFvg, title="NCI Bull Impulse FVG", style=shape.circle, location=location.belowbar, color=color.new(bullColor,15), size=size.tiny, text="FVG")
plotshape((nciV15VisualMode == "Full" or nciV15VisualMode == "Debug") and nciV15BearFvg, title="NCI Bear Impulse FVG", style=shape.circle, location=location.abovebar, color=color.new(bearColor,15), size=size.tiny, text="FVG")

var table nciV15Panel = table.new(position.bottom_right, 2, 5, border_width=1)
if barstate.islast and (nciV15VisualMode == "Compact" or nciV15VisualMode == "Full" or nciV15VisualMode == "Debug")
    nciV15Bg = color.new(themeBackgroundRef, themePanelTransparency)
    table.cell(nciV15Panel, 0, 0, "NCI Smart", text_color=themePanelText, bgcolor=color.new(themeBaseNeutral,45), text_size=size.small)
    table.cell(nciV15Panel, 1, 0, "v0.1.5", text_color=themePanelText, bgcolor=color.new(themeBaseNeutral,45), text_size=size.small)
    table.cell(nciV15Panel, 0, 1, "Buy", text_color=themePanelText, bgcolor=nciV15Bg, text_size=size.small)
    table.cell(nciV15Panel, 1, 1, str.tostring(nciV15BuyScore)+"/12 "+nciV15Grade(nciV15BuyScore), text_color=themePanelText, bgcolor=nciV15Bg, text_size=size.small)
    table.cell(nciV15Panel, 0, 2, "Sell", text_color=themePanelText, bgcolor=nciV15Bg, text_size=size.small)
    table.cell(nciV15Panel, 1, 2, str.tostring(nciV15SellScore)+"/12 "+nciV15Grade(nciV15SellScore), text_color=themePanelText, bgcolor=nciV15Bg, text_size=size.small)
    table.cell(nciV15Panel, 0, 3, "3 OK", text_color=themePanelText, bgcolor=nciV15Bg, text_size=size.small)
    table.cell(nciV15Panel, 1, 3, "B " + (nciV15ThreeBuy ? "YES" : "NO") + " / S " + (nciV15ThreeSell ? "YES" : "NO"), text_color=themePanelText, bgcolor=nciV15Bg, text_size=size.small)
    table.cell(nciV15Panel, 0, 4, "State", text_color=themePanelText, bgcolor=nciV15Bg, text_size=size.small)
    table.cell(nciV15Panel, 1, 4, nciV15BuyOk ? "BUY valid" : nciV15SellOk ? "SELL valid" : "WAIT", text_color=themePanelText, bgcolor=nciV15Bg, text_size=size.small)
