GRP_SMC    = "🏦 SMC Engine"
GRP_SATS   = "🧠 SATS Trend Quality Engine"
GRP_RISK   = "🎯 Risk / TP / SL"
GRP_VIS    = "🎨 Visuals"
GRP_HTFLVL = "🧭 HTF Key Levels"
GRP_ALERT  = "🔔 Alerts"
GRP_COL    = "🎨 Colors"

