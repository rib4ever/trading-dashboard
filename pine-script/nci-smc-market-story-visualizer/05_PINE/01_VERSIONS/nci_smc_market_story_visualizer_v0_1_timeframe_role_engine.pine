//@version=6
indicator("NCI x SMC Market Story Visualizer [Ravi Custom] v0.1", shorttitle="NCIxSMC Story v0.1", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ============================================================================
// NCI x SMC Market Story Visualizer [Ravi Custom]
// v0.1 - Timeframe Role Engine
// ============================================================================
// Purpose:
// This version begins the real story framework.
// It does NOT generate buy/sell signals.
// It establishes:
// - configurable 4-timeframe stack
// - default 4H → 1H → 15M → 5M hierarchy
// - current chart timeframe layer
// - role/alignment story panel
// - early visual hierarchy labels
//
// Core law:
// 4H  = master story
// 1H  = -1 explanation of 4H
// 15M = -1 explanation of 1H
// 5M  = -1 explanation of 15M
// Current chart TF = additional working layer when enabled
// ============================================================================

// -----------------------------------------------------------------------------
// 1. Inputs
// -----------------------------------------------------------------------------

grpTF = "01. Timeframe Story Stack"
tfSlot1 = input.timeframe("240", "TF Slot 1 - Master Story", group=grpTF)
tfSlot2 = input.timeframe("60", "TF Slot 2 - Explains Slot 1", group=grpTF)
tfSlot3 = input.timeframe("15", "TF Slot 3 - Explains Slot 2", group=grpTF)
tfSlot4 = input.timeframe("5", "TF Slot 4 - Explains Slot 3", group=grpTF)
showChartTfLayer = input.bool(true, "Show Current Chart TF Working Layer", group=grpTF)
autoAlignChartTf = input.bool(true, "Auto-align Current Chart TF into Story", group=grpTF)

grpMode = "02. Mode"
visualMode = input.string("Story", "Visual Mode", options=["Clean", "Story", "Debug"], group=grpMode)
storyMode = input.string("Hybrid NCI + SMC", "Story Mode", options=["NCI Only", "SMC Context Only", "Hybrid NCI + SMC"], group=grpMode)

grpDisplay = "03. Display"
showStoryPanel = input.bool(true, "Show Story Panel", group=grpDisplay)
showTfRoleMarker = input.bool(true, "Show Current Chart TF Role Marker", group=grpDisplay)
showDebug = input.bool(false, "Debug Mode Visuals", group=grpDisplay)

grpTrend = "04. Temporary Context Gauge"
emaLen = input.int(20, "Temporary EMA Context Length", minval=1, group=grpTrend)

// -----------------------------------------------------------------------------
// 2. Utility functions
// -----------------------------------------------------------------------------

f_tfLabel(string tf) =>
    tf == "1" ? "1M" :
     tf == "3" ? "3M" :
     tf == "5" ? "5M" :
     tf == "15" ? "15M" :
     tf == "30" ? "30M" :
     tf == "45" ? "45M" :
     tf == "60" ? "1H" :
     tf == "120" ? "2H" :
     tf == "180" ? "3H" :
     tf == "240" ? "4H" :
     tf == "D" ? "1D" :
     tf == "W" ? "1W" :
     tf == "M" ? "1Mth" : tf

f_tfMinutes(string tf) =>
    tf == "1" ? 1 :
     tf == "3" ? 3 :
     tf == "5" ? 5 :
     tf == "15" ? 15 :
     tf == "30" ? 30 :
     tf == "45" ? 45 :
     tf == "60" ? 60 :
     tf == "120" ? 120 :
     tf == "180" ? 180 :
     tf == "240" ? 240 :
     tf == "D" ? 1440 :
     tf == "W" ? 10080 :
     tf == "M" ? 43200 : na

f_chartTfMinutes() =>
    timeframe.isseconds ? 1 :
     timeframe.isminutes ? timeframe.multiplier :
     timeframe.isdaily ? 1440 * timeframe.multiplier :
     timeframe.isweekly ? 10080 * timeframe.multiplier :
     timeframe.ismonthly ? 43200 * timeframe.multiplier : na

f_sameTf(string tf, string chartPeriod) =>
    tf == chartPeriod or f_tfMinutes(tf) == f_chartTfMinutes()

f_inSelectedStack() =>
    f_sameTf(tfSlot1, timeframe.period) or f_sameTf(tfSlot2, timeframe.period) or f_sameTf(tfSlot3, timeframe.period) or f_sameTf(tfSlot4, timeframe.period)

f_chartRole() =>
    f_sameTf(tfSlot1, timeframe.period) ? "Chart TF = Slot 1 Master" :
     f_sameTf(tfSlot2, timeframe.period) ? "Chart TF = Slot 2 explains Slot 1" :
     f_sameTf(tfSlot3, timeframe.period) ? "Chart TF = Slot 3 explains Slot 2" :
     f_sameTf(tfSlot4, timeframe.period) ? "Chart TF = Slot 4 reaction" :
     showChartTfLayer ? "Chart TF = extra working layer" : "Chart TF layer hidden"

f_tempContext(float c, float e) =>
    c > e ? "Bullish context" : c < e ? "Bearish context" : "Neutral"

f_relationText(string parentState, string childState) =>
    parentState == childState ? "Aligned" :
     parentState == "Neutral" or childState == "Neutral" ? "Neutral / unclear" : "Opposing / explaining pullback"

// -----------------------------------------------------------------------------
// 3. Timeframe context requests - temporary v0.1 gauge
// -----------------------------------------------------------------------------

// IMPORTANT:
// This is not final NCI structure logic yet.
// It is only a temporary context gauge so the TF Role Engine can display a usable panel.
// Future versions replace EMA context with connected NCI market-structure states.

slot1Close = request.security(syminfo.tickerid, tfSlot1, close)
slot2Close = request.security(syminfo.tickerid, tfSlot2, close)
slot3Close = request.security(syminfo.tickerid, tfSlot3, close)
slot4Close = request.security(syminfo.tickerid, tfSlot4, close)

slot1Ema = request.security(syminfo.tickerid, tfSlot1, ta.ema(close, emaLen))
slot2Ema = request.security(syminfo.tickerid, tfSlot2, ta.ema(close, emaLen))
slot3Ema = request.security(syminfo.tickerid, tfSlot3, ta.ema(close, emaLen))
slot4Ema = request.security(syminfo.tickerid, tfSlot4, ta.ema(close, emaLen))

slot1State = f_tempContext(slot1Close, slot1Ema)
slot2State = f_tempContext(slot2Close, slot2Ema)
slot3State = f_tempContext(slot3Close, slot3Ema)
slot4State = f_tempContext(slot4Close, slot4Ema)

rel12 = f_relationText(slot1State, slot2State)
rel23 = f_relationText(slot2State, slot3State)
rel34 = f_relationText(slot3State, slot4State)

chartClose = close
chartEma = ta.ema(close, emaLen)
chartState = f_tempContext(chartClose, chartEma)
chartInStack = f_inSelectedStack()
chartRole = f_chartRole()

// -----------------------------------------------------------------------------
// 4. Story output text
// -----------------------------------------------------------------------------

stackText = f_tfLabel(tfSlot1) + " → " + f_tfLabel(tfSlot2) + " → " + f_tfLabel(tfSlot3) + " → " + f_tfLabel(tfSlot4)

basicStory = rel12 == "Aligned" and rel23 == "Aligned" and rel34 == "Aligned" ?
     "All selected TFs currently point in the same temporary context. Final NCI story not built yet." :
     "TFs are mixed. Treat lower TFs as explanation/pullback until NCI structure engine confirms."

chartLayerText = chartInStack ? "Current chart is inside selected stack." :
     showChartTfLayer ? "Current chart added as extra working layer." : "Current chart layer disabled."

// -----------------------------------------------------------------------------
// 5. Story panel
// -----------------------------------------------------------------------------

var table storyTbl = table.new(position.top_right, 2, 12, border_width=1)

f_cell(int col, int row, string txt, color bg, color tc) =>
    table.cell(storyTbl, col, row, txt, bgcolor=bg, text_color=tc)

if barstate.islast and showStoryPanel
    f_cell(0, 0, "NCI x SMC Story", color.black, color.white)
    f_cell(1, 0, "v0.1 TF Role Engine", color.black, color.white)

    f_cell(0, 1, "Stack", color.new(color.gray, 85), color.white)
    f_cell(1, 1, stackText, color.new(color.gray, 85), color.white)

    f_cell(0, 2, "Chart TF", color.new(color.gray, 90), color.white)
    f_cell(1, 2, timeframe.period + " | " + chartRole, color.new(color.gray, 90), color.white)

    f_cell(0, 3, f_tfLabel(tfSlot1) + " Master", color.new(color.gray, 90), color.white)
    f_cell(1, 3, slot1State, color.new(color.gray, 90), color.white)

    f_cell(0, 4, f_tfLabel(tfSlot2) + " explains " + f_tfLabel(tfSlot1), color.new(color.gray, 90), color.white)
    f_cell(1, 4, slot2State + " | " + rel12, color.new(color.gray, 90), color.white)

    f_cell(0, 5, f_tfLabel(tfSlot3) + " explains " + f_tfLabel(tfSlot2), color.new(color.gray, 90), color.white)
    f_cell(1, 5, slot3State + " | " + rel23, color.new(color.gray, 90), color.white)

    f_cell(0, 6, f_tfLabel(tfSlot4) + " explains " + f_tfLabel(tfSlot3), color.new(color.gray, 90), color.white)
    f_cell(1, 6, slot4State + " | " + rel34, color.new(color.gray, 90), color.white)

    f_cell(0, 7, "Chart Layer", color.new(color.gray, 90), color.white)
    f_cell(1, 7, chartLayerText + " Context: " + chartState, color.new(color.gray, 90), color.white)

    f_cell(0, 8, "Core Law", color.new(color.gray, 90), color.white)
    f_cell(1, 8, "LTF starts from HTF event anchor", color.new(color.gray, 90), color.white)

    f_cell(0, 9, "Range Law", color.new(color.gray, 90), color.white)
    f_cell(1, 9, "Range is a core chapter, not noise", color.new(color.gray, 90), color.white)

    f_cell(0, 10, "Story", color.new(color.gray, 90), color.white)
    f_cell(1, 10, basicStory, color.new(color.gray, 90), color.white)

    f_cell(0, 11, "Next Engine", color.new(color.gray, 90), color.white)
    f_cell(1, 11, "v0.2 NCI Candle Engine", color.new(color.gray, 90), color.white)

// -----------------------------------------------------------------------------
// 6. Current chart TF role marker
// -----------------------------------------------------------------------------

var label chartRoleLabel = na

if barstate.islast and showTfRoleMarker
    label.delete(chartRoleLabel)
    chartRoleLabel := label.new(
         bar_index,
         high,
         "Chart TF: " + timeframe.period + "\n" + chartRole + "\nStack: " + stackText,
         style=label.style_label_down,
         textcolor=color.white,
         color=color.new(color.black, 0),
         size=size.small)

// -----------------------------------------------------------------------------
// 7. Debug visuals
// -----------------------------------------------------------------------------

if showDebug and visualMode == "Debug" and barstate.islast
    label.new(bar_index, low, "DEBUG\nchartInStack=" + str.tostring(chartInStack) + "\nchartMin=" + str.tostring(f_chartTfMinutes()), style=label.style_label_up, textcolor=color.white, color=color.new(color.blue, 20), size=size.tiny)

// -----------------------------------------------------------------------------
// 8. Next modules
// -----------------------------------------------------------------------------

