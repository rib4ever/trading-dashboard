//@version=6
indicator("NCI x SMC Market Story Visualizer [Ravi Custom] v1.2.1", shorttitle="NCIStory", overlay=true, max_lines_count=300, max_labels_count=300)

// v1.2.1 Real NCI Key Level Engine Foundation
// Purpose: avoid calling every recent pivot a KL. Confirm KL only when structure is clear.

grpTF = "01. Timeframe Story Stack"
tf1 = input.timeframe("240", "TF Slot 1 - Master Story", group=grpTF)
tf2 = input.timeframe("60", "TF Slot 2 - Explains Slot 1", group=grpTF)
tf3 = input.timeframe("15", "TF Slot 3 - Explains Slot 2", group=grpTF)
tf4 = input.timeframe("5", "TF Slot 4 - Explains Slot 3", group=grpTF)

grpView = "02. Display"
themeMode = input.string("Light - Black Font", "Theme", options=["Light - Black Font", "Dark - White Font"], group=grpView)
panelMode = input.string("Mobile Compact", "Panel Mode", options=["Mobile Compact", "Normal", "Debug"], group=grpView)
panelPos = input.string("Top Right", "Panel Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpView)
visualMode = input.string("Ultra Clean", "Visual Detail", options=["Ultra Clean", "Story", "Debug"], group=grpView)
showParentKL = input.bool(true, "Show Parent KL", group=grpView)
showWorkingKL = input.bool(true, "Show Working KL", group=grpView)
showCandidatePivots = input.bool(false, "Show Candidate Pivots - Debug", group=grpView)

grpCalc = "03. Real KL Engine"
pLeft = input.int(3, "Pivot Left", minval=1, maxval=20, group=grpCalc)
pRight = input.int(3, "Pivot Right", minval=1, maxval=20, group=grpCalc)
atrLen = input.int(14, "ATR Length", minval=1, group=grpCalc)
minSwingAtr = input.float(0.75, "Min Swing Distance ATR", minval=0.10, maxval=5.0, step=0.05, group=grpCalc)
lineLen = input.int(130, "Working KL Length", minval=20, maxval=500, group=grpCalc)
parentLineLen = input.int(280, "Parent KL Length", minval=50, maxval=1000, group=grpCalc)
maruRatio = input.float(0.70, "Maru Body Ratio", minval=0.50, maxval=0.95, step=0.05, group=grpCalc)

isLight = themeMode == "Light - Black Font"
txt = isLight ? color.black : color.white
headBg = isLight ? color.new(color.silver, 10) : color.new(color.black, 0)
rowBg = isLight ? color.new(color.white, 72) : color.new(color.gray, 86)
altBg = isLight ? color.new(color.silver, 80) : color.new(color.gray, 90)

f_pos(string p) => p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : position.top_right
f_price(float x) => na(x) ? "n/a" : str.tostring(x, format.mintick)
f_tfMin(string tf) => tf == "1" ? 1 : tf == "3" ? 3 : tf == "5" ? 5 : tf == "15" ? 15 : tf == "30" ? 30 : tf == "60" ? 60 : tf == "240" ? 240 : tf == "D" ? 1440 : tf == "W" ? 10080 : na
f_chartMin() => timeframe.isminutes ? timeframe.multiplier : timeframe.isdaily ? 1440 * timeframe.multiplier : timeframe.isweekly ? 10080 * timeframe.multiplier : na
f_sameTf(string tf) => tf == timeframe.period or f_tfMin(tf) == f_chartMin()
f_bodyRatio() => high - low > 0 ? math.abs(close - open) / (high - low) : 0.0
f_isMaru() => f_bodyRatio() >= maruRatio

f_pivH(int occ) =>
    ph = ta.pivothigh(high, pLeft, pRight)
    ta.valuewhen(not na(ph), ph, occ)

f_pivL(int occ) =>
    pl = ta.pivotlow(low, pLeft, pRight)
    ta.valuewhen(not na(pl), pl, occ)

f_dir(float h0, float h1, float l0, float l1, float atr) =>
    enough = not na(h0) and not na(h1) and not na(l0) and not na(l1)
    swingOk = enough and math.abs(h0 - l0) >= atr * minSwingAtr
    hh = swingOk and h0 > h1
    hl = swingOk and l0 > l1
    lh = swingOk and h0 < h1
    ll = swingOk and l0 < l1
    hh and hl ? "Bullish" : lh and ll ? "Bearish" : swingOk ? "Mixed" : "Building"

f_code(string dir) => dir == "Bullish" ? 1.0 : dir == "Bearish" ? -1.0 : 0.0
f_klUp(float code, float lowCandidate) => code != 0.0 ? lowCandidate : na
f_klDn(float code, float highCandidate) => code != 0.0 ? highCandidate : na
f_status(string dir) => dir == "Bullish" ? "Confirmed bullish KLs" : dir == "Bearish" ? "Confirmed bearish KLs" : dir == "Mixed" ? "Candidate pivots only - mixed" : "No confirmed KL yet"

f_pressure(float klDn, float klUp) =>
    upBreak = not na(klDn) and close > klDn
    dnBreak = not na(klUp) and close < klUp
    upValid = upBreak and close > open and f_isMaru()
    dnValid = dnBreak and close < open and f_isMaru()
    upValid ? "Valid upside KL break" : dnValid ? "Valid downside KL break" : upBreak ? "Upside break needs confirmation" : dnBreak ? "Downside break needs confirmation" : "No KL break"

f_hState(string pDir, float pClose, float pKlDn, float pKlUp, string pressure) =>
    upBreak = not na(pKlDn) and pClose > pKlDn
    dnBreak = not na(pKlUp) and pClose < pKlUp
    upValid = upBreak and str.contains(pressure, "Valid upside")
    dnValid = dnBreak and str.contains(pressure, "Valid downside")
    pDir == "Bearish" and upValid ? "Parent bearish KL DOWN broken: child recalculates bullish" : pDir == "Bullish" and dnValid ? "Parent bullish KL UP broken: child recalculates bearish" : pDir == "Bearish" and upBreak ? "Parent bearish KL DOWN break attempt: warning only" : pDir == "Bullish" and dnBreak ? "Parent bullish KL UP break attempt: warning only" : pDir == "Bearish" ? "Parent bearish continuation active" : pDir == "Bullish" ? "Parent bullish continuation active" : pDir == "Mixed" ? "Parent mixed / transition building" : "Parent structure building"

f_childMission(string hState, string cDir) =>
    str.contains(hState, "recalculates bullish") ? "Child rebuilding bullish from broken parent KL" : str.contains(hState, "recalculates bearish") ? "Child rebuilding bearish from broken parent KL" : str.contains(hState, "warning") ? "Child warning only; parent break not validated" : str.contains(hState, "bearish continuation") and cDir == "Bullish" ? "Child pullback against bearish parent" : str.contains(hState, "bullish continuation") and cDir == "Bearish" ? "Child pullback against bullish parent" : str.contains(hState, "continuation") ? "Child aligned/explaining parent" : "Child explanation building"

f_final(string hState, string pStatus, string pressure) =>
    str.contains(hState, "recalculates bullish") ? "Parent KL broken; rebuild bullish from retest" : str.contains(hState, "recalculates bearish") ? "Parent KL broken; rebuild bearish from retest" : str.contains(hState, "warning") ? "Break attempt only; wait NCI confirmation" : str.contains(pStatus, "Candidate") ? "KLs are candidates only; wait cleaner structure" : str.contains(pStatus, "No confirmed") ? "No confirmed NCI KL yet" : str.contains(pressure, "needs confirmation") ? "At KL decision; break needs confirmation" : str.contains(hState, "continuation") ? "Parent continuation active; child explains move" : "Story building / mixed"

// MTF source values
s1C = request.security(syminfo.tickerid, tf1, close)
s2C = request.security(syminfo.tickerid, tf2, close)
s3C = request.security(syminfo.tickerid, tf3, close)
s1Atr = request.security(syminfo.tickerid, tf1, ta.atr(atrLen))
s2Atr = request.security(syminfo.tickerid, tf2, ta.atr(atrLen))
s3Atr = request.security(syminfo.tickerid, tf3, ta.atr(atrLen))

s1H0 = request.security(syminfo.tickerid, tf1, f_pivH(0))
s1H1 = request.security(syminfo.tickerid, tf1, f_pivH(1))
s1L0 = request.security(syminfo.tickerid, tf1, f_pivL(0))
s1L1 = request.security(syminfo.tickerid, tf1, f_pivL(1))
s2H0 = request.security(syminfo.tickerid, tf2, f_pivH(0))
s2H1 = request.security(syminfo.tickerid, tf2, f_pivH(1))
s2L0 = request.security(syminfo.tickerid, tf2, f_pivL(0))
s2L1 = request.security(syminfo.tickerid, tf2, f_pivL(1))
s3H0 = request.security(syminfo.tickerid, tf3, f_pivH(0))
s3H1 = request.security(syminfo.tickerid, tf3, f_pivH(1))
s3L0 = request.security(syminfo.tickerid, tf3, f_pivL(0))
s3L1 = request.security(syminfo.tickerid, tf3, f_pivL(1))

s1Dir = f_dir(s1H0, s1H1, s1L0, s1L1, s1Atr)
s2Dir = f_dir(s2H0, s2H1, s2L0, s2L1, s2Atr)
s3Dir = f_dir(s3H0, s3H1, s3L0, s3L1, s3Atr)
s1KlUp = f_klUp(f_code(s1Dir), s1L0)
s1KlDn = f_klDn(f_code(s1Dir), s1H0)
s2KlUp = f_klUp(f_code(s2Dir), s2L0)
s2KlDn = f_klDn(f_code(s2Dir), s2H0)
s3KlUp = f_klUp(f_code(s3Dir), s3L0)
s3KlDn = f_klDn(f_code(s3Dir), s3H0)

chartAtr = ta.atr(atrLen)
chH0 = f_pivH(0)
chH1 = f_pivH(1)
chL0 = f_pivL(0)
chL1 = f_pivL(1)
chDir = f_dir(chH0, chH1, chL0, chL1, chartAtr)
chKlUp = f_klUp(f_code(chDir), chL0)
chKlDn = f_klDn(f_code(chDir), chH0)
chStatus = f_status(chDir)
chPressure = f_pressure(chKlDn, chKlUp)

pDir = f_sameTf(tf4) ? s3Dir : f_sameTf(tf3) ? s2Dir : s1Dir
pClose = f_sameTf(tf4) ? s3C : f_sameTf(tf3) ? s2C : s1C
pKlUp = f_sameTf(tf4) ? s3KlUp : f_sameTf(tf3) ? s2KlUp : s1KlUp
pKlDn = f_sameTf(tf4) ? s3KlDn : f_sameTf(tf3) ? s2KlDn : s1KlDn
pStatus = f_status(pDir)
pPressure = f_pressure(pKlDn, pKlUp)
hState = f_hState(pDir, pClose, pKlDn, pKlUp, pPressure)
childMission = f_childMission(hState, chDir)
finalStory = f_final(hState, pStatus, pPressure)
confidence = str.contains(finalStory, "rebuild") ? "Recalculation" : str.contains(finalStory, "wait") or str.contains(finalStory, "confirmation") ? "Needs confirmation" : str.contains(pStatus, "Confirmed") ? "Structured" : "Building"

// Panel
var table t = table.new(f_pos(panelPos), 2, 12, border_width=1)
f_cell(int c, int r, string s, color bg) => table.cell(t, c, r, s, bgcolor=bg, text_color=txt, text_size=panelMode == "Mobile Compact" ? size.tiny : size.small)
if barstate.islast
    table.clear(t, 0, 0, 1, 11)
    f_cell(0, 0, "NCI Story", headBg)
    f_cell(1, 0, "v1.2.1", headBg)
    f_cell(0, 1, "Final", altBg)
    f_cell(1, 1, finalStory, altBg)
    f_cell(0, 2, "Confidence", rowBg)
    f_cell(1, 2, confidence, rowBg)
    f_cell(0, 3, "Parent", rowBg)
    f_cell(1, 3, pDir + " | " + pStatus, rowBg)
    f_cell(0, 4, "Working", rowBg)
    f_cell(1, 4, chDir + " | " + chStatus, rowBg)
    f_cell(0, 5, "Hierarchy", rowBg)
    f_cell(1, 5, hState, rowBg)
    f_cell(0, 6, "Child", rowBg)
    f_cell(1, 6, childMission, rowBg)
    if panelMode != "Mobile Compact"
        f_cell(0, 7, "Parent KL", rowBg)
        f_cell(1, 7, "UP " + f_price(pKlUp) + " | DOWN " + f_price(pKlDn), rowBg)
        f_cell(0, 8, "Working KL", rowBg)
        f_cell(1, 8, "UP " + f_price(chKlUp) + " | DOWN " + f_price(chKlDn), rowBg)
        f_cell(0, 9, "Pressure", rowBg)
        f_cell(1, 9, chPressure, rowBg)

// Visuals
var line pUpLine = na
var line pDnLine = na
var line wUpLine = na
var line wDnLine = na
var line cHiLine = na
var line cLoLine = na
var label pUpLab = na
var label pDnLab = na
var label wUpLab = na
var label wDnLab = na
var label cHiLab = na
var label cLoLab = na

if barstate.islast
    line.delete(pUpLine)
    line.delete(pDnLine)
    line.delete(wUpLine)
    line.delete(wDnLine)
    line.delete(cHiLine)
    line.delete(cLoLine)
    label.delete(pUpLab)
    label.delete(pDnLab)
    label.delete(wUpLab)
    label.delete(wDnLab)
    label.delete(cHiLab)
    label.delete(cLoLab)

    if showParentKL
        if not na(pKlUp)
            pUpLine := line.new(bar_index - parentLineLen, pKlUp, bar_index, pKlUp, extend=extend.right, width=2, color=color.new(color.green, 45))
            pUpLab := label.new(bar_index, pKlUp, "Parent KL UP\n" + f_price(pKlUp), style=label.style_label_left, textcolor=color.black, color=color.new(color.green, 65), size=size.tiny)
        if not na(pKlDn)
            pDnLine := line.new(bar_index - parentLineLen, pKlDn, bar_index, pKlDn, extend=extend.right, width=2, color=color.new(color.red, 45))
            pDnLab := label.new(bar_index, pKlDn, "Parent KL DOWN\n" + f_price(pKlDn), style=label.style_label_left, textcolor=color.black, color=color.new(color.red, 65), size=size.tiny)

    if showWorkingKL
        if not na(chKlUp)
            wUpLine := line.new(bar_index - lineLen, chKlUp, bar_index, chKlUp, extend=extend.right, width=1, color=color.new(color.green, 15))
            wUpLab := label.new(bar_index, chKlUp, "Working KL UP\n" + f_price(chKlUp), style=label.style_label_left, textcolor=color.white, color=color.new(color.green, 10), size=size.tiny)
        if not na(chKlDn)
            wDnLine := line.new(bar_index - lineLen, chKlDn, bar_index, chKlDn, extend=extend.right, width=1, color=color.new(color.red, 15))
            wDnLab := label.new(bar_index, chKlDn, "Working KL DOWN\n" + f_price(chKlDn), style=label.style_label_left, textcolor=color.white, color=color.new(color.red, 10), size=size.tiny)

    if showCandidatePivots and visualMode == "Debug"
        if not na(chH0)
            cHiLine := line.new(bar_index - lineLen, chH0, bar_index, chH0, extend=extend.right, width=1, style=line.style_dotted, color=color.new(color.red, 65))
            cHiLab := label.new(bar_index, chH0, "Candidate high", style=label.style_label_left, textcolor=color.black, color=color.new(color.red, 85), size=size.tiny)
        if not na(chL0)
            cLoLine := line.new(bar_index - lineLen, chL0, bar_index, chL0, extend=extend.right, width=1, style=line.style_dotted, color=color.new(color.green, 65))
            cLoLab := label.new(bar_index, chL0, "Candidate low", style=label.style_label_left, textcolor=color.black, color=color.new(color.green, 85), size=size.tiny)
