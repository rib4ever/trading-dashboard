//@version=6
indicator("NCI x SMC Market Story Visualizer [Ravi Custom] v1.4.0 Alpha", shorttitle="NCIStory", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=200, max_bars_back=1000)

// ─────────────────────────────────────────────────────────────────────────────
// v1.4.0 Alpha — Clean NCI x SMC Engine Refactor
// Engineering reference: SMC swing/state architecture.
// Logic authority: NCI market structure, market cycle, KL, breakout/pullback rules.
// Core rule: latest pivot is NOT a KL. No validation = candidate/wait only.
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// 01. Constants / Inputs
// ─────────────────────────────────────────────────────────────────────────────
grpTF = "01. TF Story Stack"
tf4h  = input.timeframe("240", "Master TF", group=grpTF)
tf1h  = input.timeframe("60",  "Child TF 1", group=grpTF)
tf15m = input.timeframe("15",  "Child TF 2", group=grpTF)
tf5m  = input.timeframe("5",   "Execution TF", group=grpTF)

grpLogic = "02. NCI Logic"
swingLen        = input.int(5, "SMC Swing Length", minval=2, maxval=20, group=grpLogic)
atrLen          = input.int(14, "ATR Length", minval=1, group=grpLogic)
maruRatio       = input.float(0.70, "NCI Maru Body Ratio", minval=0.50, maxval=0.95, step=0.05, group=grpLogic)
specialMaruBody = input.float(0.50, "Special Maru Body Ratio", minval=0.35, maxval=0.80, step=0.05, group=grpLogic)
closeNearEdge   = input.float(0.85, "Special Maru Close Near Edge", minval=0.70, maxval=0.98, step=0.01, group=grpLogic)
legAtrMin       = input.float(1.20, "Minimum Pulse Leg ATR", minval=0.30, maxval=10.0, step=0.10, group=grpLogic)
rangeAtrMax     = input.float(2.20, "Range Width ATR Max", minval=0.50, maxval=20.0, step=0.10, group=grpLogic)
breakCloseAtr   = input.float(0.15, "Break Close Buffer ATR", minval=0.00, maxval=2.0, step=0.05, group=grpLogic)
touchTolAtr     = input.float(0.35, "KL Touch Tolerance ATR", minval=0.05, maxval=3.0, step=0.05, group=grpLogic)

grpView = "03. Visual Story"
showPanel       = input.bool(true, "Show Story Panel", group=grpView)
show4h          = input.bool(true, "Show 4H", group=grpView)
show1h          = input.bool(true, "Show 1H", group=grpView)
show15m         = input.bool(true, "Show 15M", group=grpView)
show5m          = input.bool(true, "Show 5M", group=grpView)
showCandidates  = input.bool(true, "Show Candidate Edges", group=grpView)
showZones       = input.bool(true, "Show Active KL Zones", group=grpView)
showEventLabel  = input.bool(true, "Show Current Story Label", group=grpView)
lineLen         = input.int(260, "Line Length", minval=50, maxval=1000, group=grpView)
zoneLen         = input.int(160, "Zone Length", minval=30, maxval=1000, group=grpView)
theme           = input.string("Light", "Theme", options=["Light", "Dark"], group=grpView)
panelPos        = input.string("Top Right", "Panel Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpView)
panelMode       = input.string("Mobile", "Panel Mode", options=["Mobile", "Normal", "Debug"], group=grpView)

// ─────────────────────────────────────────────────────────────────────────────
// 02. Helpers
// ─────────────────────────────────────────────────────────────────────────────
isLight = theme == "Light"
txtCol  = isLight ? color.black : color.white
headBg  = isLight ? color.new(color.silver, 10) : color.new(color.black, 0)
rowBg   = isLight ? color.new(color.white, 72) : color.new(color.gray, 86)
altBg   = isLight ? color.new(color.silver, 84) : color.new(color.gray, 90)

f_pos(string p) => p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : position.top_right
f_price(float x) => na(x) ? "n/a" : str.tostring(x, format.mintick)
f_bodyRatio(float o, float h, float l, float c) => h - l > 0 ? math.abs(c - o) / (h - l) : 0.0
f_closePos(float h, float l, float c) => h - l > 0 ? (c - l) / (h - l) : 0.5
f_isBull(float o, float c) => c > o
f_isBear(float o, float c) => c < o
f_isMaru(float o, float h, float l, float c) => f_bodyRatio(o, h, l, c) >= maruRatio
f_isSpecialBull(float o, float h, float l, float c) => f_isBull(o, c) and f_bodyRatio(o, h, l, c) >= specialMaruBody and f_closePos(h, l, c) >= closeNearEdge
f_isSpecialBear(float o, float h, float l, float c) => f_isBear(o, c) and f_bodyRatio(o, h, l, c) >= specialMaruBody and f_closePos(h, l, c) <= 1.0 - closeNearEdge
f_isPowerBull(float o, float h, float l, float c) => f_isBull(o, c) and (f_isMaru(o, h, l, c) or f_isSpecialBull(o, h, l, c))
f_isPowerBear(float o, float h, float l, float c) => f_isBear(o, c) and (f_isMaru(o, h, l, c) or f_isSpecialBear(o, h, l, c))
f_mid(float a, float b) => (a + b) / 2.0

// ─────────────────────────────────────────────────────────────────────────────
// 03. SMC Swing Memory + NCI Candle/Breakout Standards
// ─────────────────────────────────────────────────────────────────────────────
f_lastPH(int occ) =>
    ph = ta.pivothigh(high, swingLen, swingLen)
    ta.valuewhen(not na(ph), ph, occ)

f_lastPL(int occ) =>
    pl = ta.pivotlow(low, swingLen, swingLen)
    ta.valuewhen(not na(pl), pl, occ)

f_twoBullBreak(float bol, float atr) =>
    okLine = not na(bol)
    c1 = close[1] > bol + atr * breakCloseAtr and f_isPowerBull(open[1], high[1], low[1], close[1])
    c2 = close > close[1] and close > bol + atr * breakCloseAtr and f_isPowerBull(open, high, low, close)
    okLine and c1 and c2

f_twoBearBreak(float bol, float atr) =>
    okLine = not na(bol)
    c1 = close[1] < bol - atr * breakCloseAtr and f_isPowerBear(open[1], high[1], low[1], close[1])
    c2 = close < close[1] and close < bol - atr * breakCloseAtr and f_isPowerBear(open, high, low, close)
    okLine and c1 and c2

f_bigSmallBullBreak(float bol, float atr) =>
    okLine = not na(bol)
    big1 = f_isPowerBull(open[1], high[1], low[1], close[1]) and math.abs(close[1] - open[1]) >= ta.sma(math.abs(close - open), 5)[1]
    small2 = low > f_mid(open[1], close[1]) and close > bol + atr * breakCloseAtr
    bodyAbove = (close[1] - math.max(open[1], bol)) / math.max(math.abs(close[1] - open[1]), syminfo.mintick) >= 0.30
    okLine and big1 and small2 and bodyAbove

f_bigSmallBearBreak(float bol, float atr) =>
    okLine = not na(bol)
    big1 = f_isPowerBear(open[1], high[1], low[1], close[1]) and math.abs(close[1] - open[1]) >= ta.sma(math.abs(close - open), 5)[1]
    small2 = high < f_mid(open[1], close[1]) and close < bol - atr * breakCloseAtr
    bodyBelow = (math.min(open[1], bol) - close[1]) / math.max(math.abs(close[1] - open[1]), syminfo.mintick) >= 0.30
    okLine and big1 and small2 and bodyBelow

f_validBullBreak(float bol, float atr) => f_twoBullBreak(bol, atr) or f_bigSmallBullBreak(bol, atr)
f_validBearBreak(float bol, float atr) => f_twoBearBreak(bol, atr) or f_bigSmallBearBreak(bol, atr)

// ─────────────────────────────────────────────────────────────────────────────
// 04. NCI State Engine
// Return order:
// cycle, event, trendDir, candLow, candHigh, klUp, klDown, zoneTop, zoneBot, reason, atr
// trendDir: 1 bull, -1 bear, 0 transition/range
// ─────────────────────────────────────────────────────────────────────────────
f_state() =>
    atr = ta.atr(atrLen)
    ph0 = f_lastPH(0)
    ph1 = f_lastPH(1)
    pl0 = f_lastPL(0)
    pl1 = f_lastPL(1)
    hasSwings = not na(ph0) and not na(ph1) and not na(pl0) and not na(pl1)
    width = hasSwings ? math.abs(ph0 - pl0) : na
    higherHigh = hasSwings and ph0 > ph1
    higherLow  = hasSwings and pl0 > pl1
    lowerHigh  = hasSwings and ph0 < ph1
    lowerLow   = hasSwings and pl0 < pl1
    rangeLike  = hasSwings and width <= atr * rangeAtrMax
    legOk      = hasSwings and width >= atr * legAtrMin
    bullBreak  = hasSwings and higherLow and f_validBullBreak(ph1, atr)
    bearBreak  = hasSwings and lowerHigh and f_validBearBreak(pl1, atr)
    bullCandidate = hasSwings and higherHigh and higherLow and legOk
    bearCandidate = hasSwings and lowerHigh and lowerLow and legOk
    int dir = bullBreak ? 1 : bearBreak ? -1 : 0
    string cycle = bullBreak ? "Bullish cycle confirmed" : bearBreak ? "Bearish cycle confirmed" : bullCandidate ? "Bullish cycle candidate" : bearCandidate ? "Bearish cycle candidate" : rangeLike ? "Range / absorption candidate" : hasSwings ? "Transition / wait" : "Building swing memory"
    string event = bullBreak ? "Valid bullish breakout; KL recalculated from pullback low" : bearBreak ? "Valid bearish breakdown; KL recalculated from pullback high" : bullCandidate ? "Bullish structure candidate; wait for NCI breakout" : bearCandidate ? "Bearish structure candidate; wait for NCI breakdown" : rangeLike ? "Range candidate; trade edges only after confirmation" : hasSwings ? "No valid NCI break/pullback yet" : "Not enough swing data"
    float klUp = bullBreak ? pl0 : na
    float klDn = bearBreak ? ph0 : na
    float candLow = hasSwings ? pl0 : na
    float candHigh = hasSwings ? ph0 : na
    float zTop = bullBreak ? math.max(open[swingLen], pl0) : bearBreak ? ph0 : na
    float zBot = bullBreak ? pl0 : bearBreak ? math.min(open[swingLen], ph0) : na
    string reason = bullBreak or bearBreak ? "Confirmed by NCI breakout standard" : "No confirmed KL: pivot/structure is candidate only"
    [cycle, event, dir, candLow, candHigh, klUp, klDn, zTop, zBot, reason, atr]

[cy4, ev4, dir4, candLow4, candHigh4, klUp4, klDn4, zTop4, zBot4, reason4, atr4] = request.security(syminfo.tickerid, tf4h, f_state())
[cy1, ev1, dir1, candLow1, candHigh1, klUp1, klDn1, zTop1, zBot1, reason1, atr1] = request.security(syminfo.tickerid, tf1h, f_state())
[cy15, ev15, dir15, candLow15, candHigh15, klUp15, klDn15, zTop15, zBot15, reason15, atr15] = request.security(syminfo.tickerid, tf15m, f_state())
[cy5, ev5, dir5, candLow5, candHigh5, klUp5, klDn5, zTop5, zBot5, reason5, atr5] = request.security(syminfo.tickerid, tf5m, f_state())

// ─────────────────────────────────────────────────────────────────────────────
// 05. MTF Hierarchy / Story Mode
// ─────────────────────────────────────────────────────────────────────────────
f_role(int parentDir, string parentCycle, int childDir, string childCycle, string layer) =>
    parentConfirmed = parentDir != 0
    childConfirmed = childDir != 0
    parentNotReady = not parentConfirmed
    parentNotReady ? layer + " waits; parent has no confirmed KL" : childConfirmed and childDir == parentDir ? layer + " aligned; explains parent continuation" : childConfirmed and childDir != parentDir ? layer + " counter-move; possible pullback against parent" : str.contains(childCycle, "Range") ? layer + " range/absorption inside parent" : layer + " transition; wait for NCI confirmation"

role1  = f_role(dir4, cy4, dir1, cy1, "1H")
role15 = f_role(dir1, cy1, dir15, cy15, "15M")
role5  = f_role(dir15, cy15, dir5, cy5, "5M")

master = dir4 == 1 ? "4H bullish story active" : dir4 == -1 ? "4H bearish story active" : "No confirmed 4H parent KL yet"
finalStory = dir4 == 0 ? "WAIT: parent not confirmed" : dir1 != 0 and dir1 != dir4 ? "PULLBACK: child counter-move against 4H" : dir1 == dir4 and dir15 == dir4 ? "CONTINUATION: 4H/1H/15M aligned" : "STORY BUILDING: wait for lower TF confirmation"
confidence = dir4 != 0 and dir1 == dir4 and dir15 == dir4 ? "Structured" : dir4 != 0 ? "Parent confirmed; child building" : "Building"

// ─────────────────────────────────────────────────────────────────────────────
// 06. Panel
// ─────────────────────────────────────────────────────────────────────────────
var table panel = table.new(f_pos(panelPos), 2, 16, border_width=1)
f_cell(int c, int r, string s, color bg) => table.cell(panel, c, r, s, bgcolor=bg, text_color=txtCol, text_size=panelMode == "Mobile" ? size.tiny : size.small)

if barstate.islast and showPanel
    table.clear(panel, 0, 0, 1, 15)
    f_cell(0, 0, "NCI x SMC", headBg)
    f_cell(1, 0, "v1.4.0 alpha", headBg)
    f_cell(0, 1, "Final", altBg)
    f_cell(1, 1, finalStory, altBg)
    f_cell(0, 2, "Confidence", rowBg)
    f_cell(1, 2, confidence, rowBg)
    f_cell(0, 3, "Master", rowBg)
    f_cell(1, 3, master, rowBg)
    f_cell(0, 4, "4H Event", rowBg)
    f_cell(1, 4, ev4, rowBg)
    f_cell(0, 5, "1H Role", rowBg)
    f_cell(1, 5, role1, rowBg)
    f_cell(0, 6, "15M Role", rowBg)
    f_cell(1, 6, role15, rowBg)
    f_cell(0, 7, "5M Role", rowBg)
    f_cell(1, 7, role5, rowBg)
    f_cell(0, 8, "4H KL", rowBg)
    f_cell(1, 8, "UP " + f_price(klUp4) + " | DOWN " + f_price(klDn4), rowBg)
    f_cell(0, 9, "1H KL", rowBg)
    f_cell(1, 9, "UP " + f_price(klUp1) + " | DOWN " + f_price(klDn1), rowBg)
    if panelMode == "Debug"
        f_cell(0, 10, "4H Cycle", rowBg)
        f_cell(1, 10, cy4, rowBg)
        f_cell(0, 11, "1H Cycle", rowBg)
        f_cell(1, 11, cy1, rowBg)
        f_cell(0, 12, "15M Cycle", rowBg)
        f_cell(1, 12, cy15, rowBg)
        f_cell(0, 13, "5M Cycle", rowBg)
        f_cell(1, 13, cy5, rowBg)

// ─────────────────────────────────────────────────────────────────────────────
// 07. Visuals — separate typed declarations to avoid Pine NA type errors
// ─────────────────────────────────────────────────────────────────────────────
var line l4u = na
var line l4d = na
var line l1u = na
var line l1d = na
var line l15u = na
var line l15d = na
var line l5u = na
var line l5d = na
var line c4h = na
var line c4l = na
var line c1h = na
var line c1l = na
var line c15h = na
var line c15l = na
var line c5h = na
var line c5l = na
var label lab4u = na
var label lab4d = na
var label lab1u = na
var label lab1d = na
var label lab15u = na
var label lab15d = na
var label lab5u = na
var label lab5d = na
var label cand4hLab = na
var label cand4lLab = na
var label cand1hLab = na
var label cand1lLab = na
var label cand15hLab = na
var label cand15lLab = na
var label cand5hLab = na
var label cand5lLab = na
var label storyLab = na
var box z4 = na
var box z1 = na
var box z15 = na
var box z5 = na

f_line(float level, color col, int w) => line.new(bar_index - lineLen, level, bar_index, level, extend=extend.right, color=col, width=w)
f_lab(float level, string s, color bg) => label.new(bar_index, level, s, style=label.style_label_left, color=bg, textcolor=color.black, size=size.tiny)
f_zone(float top, float bot, color col) => box.new(bar_index - zoneLen, top, bar_index, bot, bgcolor=color.new(col, 88), border_color=color.new(col, 35), extend=extend.right)

if barstate.islast
    line.delete(l4u), line.delete(l4d), line.delete(l1u), line.delete(l1d), line.delete(l15u), line.delete(l15d), line.delete(l5u), line.delete(l5d)
    line.delete(c4h), line.delete(c4l), line.delete(c1h), line.delete(c1l), line.delete(c15h), line.delete(c15l), line.delete(c5h), line.delete(c5l)
    label.delete(lab4u), label.delete(lab4d), label.delete(lab1u), label.delete(lab1d), label.delete(lab15u), label.delete(lab15d), label.delete(lab5u), label.delete(lab5d)
    label.delete(cand4hLab), label.delete(cand4lLab), label.delete(cand1hLab), label.delete(cand1lLab), label.delete(cand15hLab), label.delete(cand15lLab), label.delete(cand5hLab), label.delete(cand5lLab)
    label.delete(storyLab)
    box.delete(z4), box.delete(z1), box.delete(z15), box.delete(z5)

    if showZones and show4h and not na(zTop4) and not na(zBot4)
        z4 := f_zone(zTop4, zBot4, color.aqua)
    if showZones and show1h and not na(zTop1) and not na(zBot1)
        z1 := f_zone(zTop1, zBot1, color.teal)
    if showZones and show15m and not na(zTop15) and not na(zBot15)
        z15 := f_zone(zTop15, zBot15, color.green)
    if showZones and show5m and not na(zTop5) and not na(zBot5)
        z5 := f_zone(zTop5, zBot5, color.gray)

    if show4h and not na(klUp4)
        l4u := f_line(klUp4, color.new(color.aqua, 5), 3)
        lab4u := f_lab(klUp4, "4H CONFIRMED KL UP\n" + f_price(klUp4), color.new(color.aqua, 75))
    if show4h and not na(klDn4)
        l4d := f_line(klDn4, color.new(color.fuchsia, 5), 3)
        lab4d := f_lab(klDn4, "4H CONFIRMED KL DOWN\n" + f_price(klDn4), color.new(color.fuchsia, 75))
    if show1h and not na(klUp1)
        l1u := f_line(klUp1, color.new(color.teal, 10), 2)
        lab1u := f_lab(klUp1, "1H CONFIRMED KL UP\n" + f_price(klUp1), color.new(color.teal, 78))
    if show1h and not na(klDn1)
        l1d := f_line(klDn1, color.new(color.red, 10), 2)
        lab1d := f_lab(klDn1, "1H CONFIRMED KL DOWN\n" + f_price(klDn1), color.new(color.red, 80))
    if show15m and not na(klUp15)
        l15u := f_line(klUp15, color.new(color.green, 10), 1)
        lab15u := f_lab(klUp15, "15M CONFIRMED KL UP\n" + f_price(klUp15), color.new(color.green, 82))
    if show15m and not na(klDn15)
        l15d := f_line(klDn15, color.new(color.red, 15), 1)
        lab15d := f_lab(klDn15, "15M CONFIRMED KL DOWN\n" + f_price(klDn15), color.new(color.red, 84))
    if show5m and not na(klUp5)
        l5u := f_line(klUp5, color.new(color.lime, 20), 1)
        lab5u := f_lab(klUp5, "5M KL UP\n" + f_price(klUp5), color.new(color.lime, 86))
    if show5m and not na(klDn5)
        l5d := f_line(klDn5, color.new(color.orange, 20), 1)
        lab5d := f_lab(klDn5, "5M KL DOWN\n" + f_price(klDn5), color.new(color.orange, 86))

    if showCandidates and show4h and na(klDn4) and not na(candHigh4)
        c4h := f_line(candHigh4, color.new(color.fuchsia, 80), 1)
        cand4hLab := f_lab(candHigh4, "4H candidate HIGH\nnot KL", color.new(color.fuchsia, 92))
    if showCandidates and show4h and na(klUp4) and not na(candLow4)
        c4l := f_line(candLow4, color.new(color.aqua, 80), 1)
        cand4lLab := f_lab(candLow4, "4H candidate LOW\nnot KL", color.new(color.aqua, 92))
    if showCandidates and show1h and na(klDn1) and not na(candHigh1)
        c1h := f_line(candHigh1, color.new(color.red, 82), 1)
        cand1hLab := f_lab(candHigh1, "1H candidate HIGH\nnot KL", color.new(color.red, 92))
    if showCandidates and show1h and na(klUp1) and not na(candLow1)
        c1l := f_line(candLow1, color.new(color.teal, 82), 1)
        cand1lLab := f_lab(candLow1, "1H candidate LOW\nnot KL", color.new(color.teal, 92))
    if showCandidates and show15m and na(klDn15) and not na(candHigh15)
        c15h := f_line(candHigh15, color.new(color.red, 86), 1)
        cand15hLab := f_lab(candHigh15, "15M candidate HIGH\nnot KL", color.new(color.red, 94))
    if showCandidates and show15m and na(klUp15) and not na(candLow15)
        c15l := f_line(candLow15, color.new(color.green, 86), 1)
        cand15lLab := f_lab(candLow15, "15M candidate LOW\nnot KL", color.new(color.green, 94))
    if showCandidates and show5m and na(klDn5) and not na(candHigh5)
        c5h := f_line(candHigh5, color.new(color.orange, 88), 1)
        cand5hLab := f_lab(candHigh5, "5M candidate HIGH\nnot KL", color.new(color.orange, 94))
    if showCandidates and show5m and na(klUp5) and not na(candLow5)
        c5l := f_line(candLow5, color.new(color.lime, 88), 1)
        cand5lLab := f_lab(candLow5, "5M candidate LOW\nnot KL", color.new(color.lime, 94))

    if showEventLabel
        storyLab := label.new(bar_index, close, "NCI STORY\n" + finalStory, style=label.style_label_left, color=color.new(color.silver, 70), textcolor=txtCol, size=size.tiny)
