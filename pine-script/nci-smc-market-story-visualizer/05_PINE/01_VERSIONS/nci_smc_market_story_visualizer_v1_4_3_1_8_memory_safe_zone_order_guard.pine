//@version=6
indicator("NCI x SMC Market Story Visualizer [Ravi Custom] v1.4.3.1.8", shorttitle="NCIStory", overlay=true, max_lines_count=300, max_labels_count=300, max_boxes_count=180, max_bars_back=1200)

// v1.4.3.1.8 — Memory-Safe Zone Order Guard
// Fixes from v1.4.3.1.7:
// - Removes the heavy diagnostic object load that caused TradingView memory-limit errors on 4H.
// - Prevents impossible active mapping: Supply below Demand.
// - Broken zones are not used as active story zones by default.
// - Keeps the 4H → 1H → 15M → 5M hierarchy and 5M execution monitor.
// - Keeps Hybrid NCI + SMC concept, but uses a lightweight engine safe for mobile TradingView.

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
grpTF = "01. TF Story Stack"
tf4h  = input.timeframe("240", "Master TF", group=grpTF)
tf1h  = input.timeframe("60", "Child TF 1", group=grpTF)
tf15m = input.timeframe("15", "Child TF 2", group=grpTF)
tf5m  = input.timeframe("5", "Execution TF", group=grpTF)

grpL = "02. KL Engine"
swingLen      = input.int(5, "Swing Length", minval=2, maxval=20, group=grpL)
atrLen        = input.int(14, "ATR Length", minval=1, group=grpL)
requireBOS    = input.bool(true, "Require BOS to Confirm KL", group=grpL)
bosUseClose   = input.bool(false, "BOS Requires Close Beyond Structure", group=grpL)
bosBufferAtr  = input.float(0.05, "BOS Buffer ATR", minval=0.0, maxval=2.0, step=0.01, group=grpL)
mitigateAtr   = input.float(0.05, "Break/Mitigation Buffer ATR", minval=0.0, maxval=1.0, step=0.01, group=grpL)
klSource      = input.string("Hybrid NCI + SMC", "Key Level Source", options=["NCI Pivot BOS", "SMC OB / FVG", "Hybrid NCI + SMC"], group=grpL)
klDrawMode    = input.string("Whole Candle", "NCI KL Draw Mode", options=["Whole Candle", "NCI Dynamic"], group=grpL)
showBrokenZones = input.bool(false, "Show Broken Zones", group=grpL)

// NCI candle pressure standards
grpP = "03. NCI Pressure Standards"
maruBodyRatio = input.float(0.70, "Marubozu Body Ratio", minval=0.50, maxval=0.95, step=0.05, group=grpP)
specialMaruBody = input.float(0.50, "Special Maru Body Ratio", minval=0.35, maxval=0.90, step=0.05, group=grpP)
nearZoneAtr = input.float(2.0, "Near Zone ATR", minval=0.25, maxval=10.0, step=0.25, group=grpP)
minZoneAtr = input.float(0.06, "Minimum Zone Thickness ATR", minval=0.01, maxval=1.0, step=0.01, group=grpP)

// Visuals
grpV = "04. Visuals"
showPanel      = input.bool(true, "Show Story Panel", group=grpV)
show4h         = input.bool(true, "Show 4H Master KL", group=grpV)
show1h         = input.bool(true, "Show 1H Context", group=grpV)
show15m        = input.bool(true, "Show 15M Context", group=grpV)
show5m         = input.bool(true, "Show 5M Context", group=grpV)
visualMode     = input.string("Story", "Visual Mode", options=["Story", "Full", "Debug"], group=grpV)
compactLabels  = input.bool(true, "Compact Child Labels", group=grpV)
futureBars     = input.int(50, "Right Label Offset", minval=10, maxval=250, group=grpV)
theme          = input.string("Light", "Theme", options=["Light", "Dark"], group=grpV)
panelPos       = input.string("Top Right", "Panel Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpV)
panelMode      = input.string("Mobile", "Panel Mode", options=["Mobile", "Normal", "Debug"], group=grpV)

grpE = "05. 5M Execution Monitor"
showExecZone       = input.bool(true, "Show 5M Execution Zone", group=grpE)
execVisibility     = input.string("15M and below", "Execution Zone Visibility", options=["Execution TF only", "15M and below", "All timeframes"], group=grpE)
execNeedsFullStory = input.bool(true, "Execution Requires Full Story Alignment", group=grpE)

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────────────
isLight = theme == "Light"
txtCol = isLight ? color.black : color.white
headBg = isLight ? color.new(color.silver, 10) : color.new(color.black, 0)
rowBg  = isLight ? color.new(color.white, 74) : color.new(color.gray, 86)
altBg  = isLight ? color.new(color.silver, 86) : color.new(color.gray, 90)

f_pos(string p) => p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : position.top_right
f_price(float x) => na(x) ? "n/a" : str.tostring(x, format.mintick)
f_rightTime(int barsForward) => time + timeframe.in_seconds(timeframe.period) * 1000 * barsForward
f_body(float o, float c) => math.abs(c - o)
f_rng(float h, float l) => math.max(h - l, syminfo.mintick)
f_bodyRatio(float o, float h, float l, float c) => f_body(o, c) / f_rng(h, l)
f_zoneOk(float top, float bot) => not na(top) and not na(bot) and top > bot
f_inside(float top, float bot) => f_zoneOk(top, bot) and close <= top and close >= bot
f_nearZone(float top, float bot, float atr) => f_zoneOk(top, bot) and close <= top + atr * nearZoneAtr and close >= bot - atr * nearZoneAtr
f_chartMin() => timeframe.isminutes ? timeframe.multiplier : timeframe.isseconds ? 1 : timeframe.isdaily ? 1440 : timeframe.isweekly ? 10080 : 240

f_isMaru(float o, float h, float l, float c) => f_bodyRatio(o, h, l, c) >= maruBodyRatio
f_isSpecialBull(float o, float h, float l, float c) => c > o and f_bodyRatio(o, h, l, c) >= specialMaruBody and (c - l) / f_rng(h, l) >= 0.85
f_isSpecialBear(float o, float h, float l, float c) => c < o and f_bodyRatio(o, h, l, c) >= specialMaruBody and (h - c) / f_rng(h, l) >= 0.85

f_supplyBottom(float o, float h, float l, float c) =>
    body = math.max(f_body(o, c), syminfo.mintick)
    upperWick = h - math.max(o, c)
    hugeWick = upperWick >= body * 1.50
    hugeBody = f_bodyRatio(o, h, l, c) >= 0.70
    dynamicBottom = hugeWick ? h - upperWick * 0.50 : hugeBody ? math.max(o, c) : math.min(o, c)
    klDrawMode == "Whole Candle" ? l : dynamicBottom

f_demandTop(float o, float h, float l, float c) =>
    body = math.max(f_body(o, c), syminfo.mintick)
    lowerWick = math.min(o, c) - l
    hugeWick = lowerWick >= body * 1.50
    hugeBody = f_bodyRatio(o, h, l, c) >= 0.70
    dynamicTop = hugeWick ? l + lowerWick * 0.50 : hugeBody ? math.min(o, c) : math.max(o, c)
    klDrawMode == "Whole Candle" ? h : dynamicTop

f_fixSupplyBottom(float top, float bottom, float atr) => math.min(bottom, top - atr * minZoneAtr)
f_fixDemandTop(float bottom, float top, float atr) => math.max(top, bottom + atr * minZoneAtr)

f_life(float top, float bot, bool supplySide, float atr) =>
    not f_zoneOk(top, bot) ? "None" : supplySide ? close > top + atr * mitigateAtr ? "Broken" : high >= bot and close <= top ? "Mitigating" : "Active" : close < bot - atr * mitigateAtr ? "Broken" : low <= top and close >= bot ? "Mitigating" : "Active"

f_score(bool bos, bool pressure, bool near, string life) =>
    base = 0
    base += bos ? 35 : 0
    base += pressure ? 25 : 0
    base += near ? 25 : 0
    base += life == "Active" ? 15 : life == "Mitigating" ? 10 : 0
    math.min(base, 100)

f_chooseTop(float nTop, float nBot, float oTop, float oBot, float fTop, float fBot) =>
    nOk = f_zoneOk(nTop, nBot)
    oOk = f_zoneOk(oTop, oBot)
    fOk = f_zoneOk(fTop, fBot)
    oDist = oOk ? math.abs(close - (oTop + oBot) / 2.0) : 10e10
    fDist = fOk ? math.abs(close - (fTop + fBot) / 2.0) : 10e10
    klSource == "NCI Pivot BOS" ? nTop : klSource == "SMC OB / FVG" ? oOk ? oTop : fOk ? fTop : nTop : fOk and fDist <= oDist ? fTop : oOk ? oTop : nOk ? nTop : na

f_chooseBot(float nTop, float nBot, float oTop, float oBot, float fTop, float fBot) =>
    nOk = f_zoneOk(nTop, nBot)
    oOk = f_zoneOk(oTop, oBot)
    fOk = f_zoneOk(fTop, fBot)
    oDist = oOk ? math.abs(close - (oTop + oBot) / 2.0) : 10e10
    fDist = fOk ? math.abs(close - (fTop + fBot) / 2.0) : 10e10
    klSource == "NCI Pivot BOS" ? nBot : klSource == "SMC OB / FVG" ? oOk ? oBot : fOk ? fBot : nBot : fOk and fDist <= oDist ? fBot : oOk ? oBot : nOk ? nBot : na

f_chooseTime(int nTime, int oTime, int fTime, float oTop, float oBot, float fTop, float fBot) =>
    oOk = f_zoneOk(oTop, oBot)
    fOk = f_zoneOk(fTop, fBot)
    oDist = oOk ? math.abs(close - (oTop + oBot) / 2.0) : 10e10
    fDist = fOk ? math.abs(close - (fTop + fBot) / 2.0) : 10e10
    klSource == "NCI Pivot BOS" ? nTime : klSource == "SMC OB / FVG" ? oOk ? oTime : fOk ? fTime : nTime : fOk and fDist <= oDist ? fTime : oOk ? oTime : nTime

f_src(float nTop, float nBot, float oTop, float oBot, float fTop, float fBot) =>
    oOk = f_zoneOk(oTop, oBot)
    fOk = f_zoneOk(fTop, fBot)
    oDist = oOk ? math.abs(close - (oTop + oBot) / 2.0) : 10e10
    fDist = fOk ? math.abs(close - (fTop + fBot) / 2.0) : 10e10
    klSource == "NCI Pivot BOS" ? "NCI" : klSource == "SMC OB / FVG" ? oOk ? "SMC OB" : fOk ? "SMC FVG" : "NCI fallback" : fOk and fDist <= oDist ? "Hybrid FVG" : oOk ? "Hybrid OB" : f_zoneOk(nTop, nBot) ? "Hybrid NCI" : "None"

// ─────────────────────────────────────────────────────────────────────────────
// Timeframe state engine — lightweight and repeated on every TF
// ─────────────────────────────────────────────────────────────────────────────
f_state() =>
    atr = ta.atr(atrLen)
    ph = ta.pivothigh(high, swingLen, swingLen)
    pl = ta.pivotlow(low, swingLen, swingLen)

    ph0 = ta.valuewhen(not na(ph), ph, 0)
    ph1 = ta.valuewhen(not na(ph), ph, 1)
    pl0 = ta.valuewhen(not na(pl), pl, 0)
    pl1 = ta.valuewhen(not na(pl), pl, 1)
    phT0 = ta.valuewhen(not na(ph), time[swingLen], 0)
    plT0 = ta.valuewhen(not na(pl), time[swingLen], 0)
    phO0 = ta.valuewhen(not na(ph), open[swingLen], 0)
    phL0 = ta.valuewhen(not na(ph), low[swingLen], 0)
    phC0 = ta.valuewhen(not na(ph), close[swingLen], 0)
    plO0 = ta.valuewhen(not na(pl), open[swingLen], 0)
    plH0 = ta.valuewhen(not na(pl), high[swingLen], 0)
    plC0 = ta.valuewhen(not na(pl), close[swingLen], 0)

    bullBreak = not na(ph1) and (bosUseClose ? close > ph1 + atr * bosBufferAtr : high > ph1 + atr * bosBufferAtr)
    bearBreak = not na(pl1) and (bosUseClose ? close < pl1 - atr * bosBufferAtr : low < pl1 - atr * bosBufferAtr)

    // NCI pivot KL candidate.
    nSTopRaw = ph0
    nSBotRaw = f_fixSupplyBottom(ph0, f_supplyBottom(phO0, ph0, phL0, phC0), atr)
    nDTopRaw = f_fixDemandTop(pl0, f_demandTop(plO0, plH0, pl0, plC0), atr)
    nDBotRaw = pl0
    nSTop = requireBOS ? ta.valuewhen(bearBreak, nSTopRaw, 0) : nSTopRaw
    nSBot = requireBOS ? ta.valuewhen(bearBreak, nSBotRaw, 0) : nSBotRaw
    nSTime = requireBOS ? ta.valuewhen(bearBreak, phT0, 0) : phT0
    nDTop = requireBOS ? ta.valuewhen(bullBreak, nDTopRaw, 0) : nDTopRaw
    nDBot = requireBOS ? ta.valuewhen(bullBreak, nDBotRaw, 0) : nDBotRaw
    nDTime = requireBOS ? ta.valuewhen(bullBreak, plT0, 0) : plT0

    // Lightweight SMC origin: last opposite candle captured at BOS.
    lastBearTop = ta.valuewhen(close < open, open, 0)
    lastBearBot = ta.valuewhen(close < open, low, 0)
    lastBearTime = ta.valuewhen(close < open, time, 0)
    lastBullTop = ta.valuewhen(close > open, high, 0)
    lastBullBot = ta.valuewhen(close > open, open, 0)
    lastBullTime = ta.valuewhen(close > open, time, 0)
    oDTop = ta.valuewhen(bullBreak, lastBearTop, 0)
    oDBot = ta.valuewhen(bullBreak, lastBearBot, 0)
    oDTime = ta.valuewhen(bullBreak, lastBearTime, 0)
    oSTop = ta.valuewhen(bearBreak, lastBullTop, 0)
    oSBot = ta.valuewhen(bearBreak, lastBullBot, 0)
    oSTime = ta.valuewhen(bearBreak, lastBullTime, 0)

    // Latest FVG captured at structural break.
    bullFvg = low > high[2]
    bearFvg = high < low[2]
    lastBullFvgTop = ta.valuewhen(bullFvg, low, 0)
    lastBullFvgBot = ta.valuewhen(bullFvg, high[2], 0)
    lastBullFvgTime = ta.valuewhen(bullFvg, time[1], 0)
    lastBearFvgTop = ta.valuewhen(bearFvg, low[2], 0)
    lastBearFvgBot = ta.valuewhen(bearFvg, high, 0)
    lastBearFvgTime = ta.valuewhen(bearFvg, time[1], 0)
    fDTop = ta.valuewhen(bullBreak, lastBullFvgTop, 0)
    fDBot = ta.valuewhen(bullBreak, lastBullFvgBot, 0)
    fDTime = ta.valuewhen(bullBreak, lastBullFvgTime, 0)
    fSTop = ta.valuewhen(bearBreak, lastBearFvgTop, 0)
    fSBot = ta.valuewhen(bearBreak, lastBearFvgBot, 0)
    fSTime = ta.valuewhen(bearBreak, lastBearFvgTime, 0)

    sTop0 = f_chooseTop(nSTop, nSBot, oSTop, oSBot, fSTop, fSBot)
    sBot0 = f_chooseBot(nSTop, nSBot, oSTop, oSBot, fSTop, fSBot)
    sTime0 = f_chooseTime(nSTime, oSTime, fSTime, oSTop, oSBot, fSTop, fSBot)
    dTop0 = f_chooseTop(nDTop, nDBot, oDTop, oDBot, fDTop, fDBot)
    dBot0 = f_chooseBot(nDTop, nDBot, oDTop, oDBot, fDTop, fDBot)
    dTime0 = f_chooseTime(nDTime, oDTime, fDTime, oDTop, oDBot, fDTop, fDBot)

    sLife0 = f_life(sTop0, sBot0, true, atr)
    dLife0 = f_life(dTop0, dBot0, false, atr)

    // Critical guard: active Supply cannot sit below active Demand.
    // If inverted, remove broken/invalid side instead of drawing a false market map.
    sTop1 = showBrokenZones or sLife0 != "Broken" ? sTop0 : na
    sBot1 = showBrokenZones or sLife0 != "Broken" ? sBot0 : na
    sTime1 = showBrokenZones or sLife0 != "Broken" ? sTime0 : na
    dTop1 = showBrokenZones or dLife0 != "Broken" ? dTop0 : na
    dBot1 = showBrokenZones or dLife0 != "Broken" ? dBot0 : na
    dTime1 = showBrokenZones or dLife0 != "Broken" ? dTime0 : na
    inverted = f_zoneOk(sTop1, sBot1) and f_zoneOk(dTop1, dBot1) and sBot1 <= dTop1
    sTop = inverted and sLife0 == "Broken" ? na : sTop1
    sBot = inverted and sLife0 == "Broken" ? na : sBot1
    sTime = inverted and sLife0 == "Broken" ? na : sTime1
    dTop = inverted and dLife0 == "Broken" ? na : dTop1
    dBot = inverted and dLife0 == "Broken" ? na : dBot1
    dTime = inverted and dLife0 == "Broken" ? na : dTime1

    // If still inverted after broken-zone removal, keep the zone closest to current price and hide the other.
    stillInv = f_zoneOk(sTop, sBot) and f_zoneOk(dTop, dBot) and sBot <= dTop
    sDist = f_zoneOk(sTop, sBot) ? math.abs(close - (sTop + sBot) / 2.0) : 10e10
    dDist = f_zoneOk(dTop, dBot) ? math.abs(close - (dTop + dBot) / 2.0) : 10e10
    sTopF = stillInv and dDist <= sDist ? na : sTop
    sBotF = stillInv and dDist <= sDist ? na : sBot
    sTimeF = stillInv and dDist <= sDist ? na : sTime
    dTopF = stillInv and sDist < dDist ? na : dTop
    dBotF = stillInv and sDist < dDist ? na : dBot
    dTimeF = stillInv and sDist < dDist ? na : dTime

    sLife = f_life(sTopF, sBotF, true, atr)
    dLife = f_life(dTopF, dBotF, false, atr)
    inS = f_inside(sTopF, sBotF)
    inD = f_inside(dTopF, dBotF)
    hasBoth = f_zoneOk(sTopF, sBotF) and f_zoneOk(dTopF, dBotF)
    hasDemand = f_zoneOk(dTopF, dBotF)
    hasSupply = f_zoneOk(sTopF, sBotF)
    mid = hasBoth ? (sBotF + dTopF) / 2.0 : close
    bias = inS or inD ? 0 : hasBoth ? close > sTopF ? 1 : close < dBotF ? -1 : close >= mid ? -1 : 1 : hasDemand and close >= dBotF ? 1 : hasSupply and close <= sTopF ? -1 : 0

    pressureBull = f_isMaru(open, high, low, close) and close > open or f_isSpecialBull(open, high, low, close)
    pressureBear = f_isMaru(open, high, low, close) and close < open or f_isSpecialBear(open, high, low, close)
    scoreS = f_score(bearBreak, pressureBear, f_nearZone(sTopF, sBotF, atr), sLife)
    scoreD = f_score(bullBreak, pressureBull, f_nearZone(dTopF, dBotF, atr), dLife)
    srcS = f_src(nSTop, nSBot, oSTop, oSBot, fSTop, fSBot)
    srcD = f_src(nDTop, nDBot, oDTop, oDBot, fDTop, fDBot)
    event = bullBreak ? "Bullish BOS" : bearBreak ? "Bearish BOS" : inS ? "Supply decision" : inD ? "Demand decision" : "No fresh event"
    loc = inS ? "Inside Supply" : inD ? "Inside Demand" : hasBoth ? close > sTopF ? "Above Supply" : close < dBotF ? "Below Demand" : "Between Supply and Demand" : hasDemand ? close >= dBotF ? "Above/At Demand" : "Below Demand" : hasSupply ? close <= sTopF ? "Below/At Supply" : "Above Supply" : "Building KL memory"
    story = loc == "Inside Supply" ? "Supply decision active" : loc == "Inside Demand" ? "Demand decision active" : bias == 1 ? "Demand story active" : bias == -1 ? "Supply story active" : "Range / building story"

    [sTopF, sBotF, sTimeF, dTopF, dBotF, dTimeF, bias, story, loc, event, sLife, dLife, srcS, srcD, scoreS, scoreD]

[s4Top, s4Bot, s4Time, d4Top, d4Bot, d4Time, b4, story4, loc4, event4, sLife4, dLife4, srcS4, srcD4, scoreS4, scoreD4] = request.security(syminfo.tickerid, tf4h, f_state())
[s1Top, s1Bot, s1Time, d1Top, d1Bot, d1Time, b1, story1, loc1, event1, sLife1, dLife1, srcS1, srcD1, scoreS1, scoreD1] = request.security(syminfo.tickerid, tf1h, f_state())
[s15Top, s15Bot, s15Time, d15Top, d15Bot, d15Time, b15, story15, loc15, event15, sLife15, dLife15, srcS15, srcD15, scoreS15, scoreD15] = request.security(syminfo.tickerid, tf15m, f_state())
[s5Top, s5Bot, s5Time, d5Top, d5Bot, d5Time, b5, story5, loc5, event5, sLife5, dLife5, srcS5, srcD5, scoreS5, scoreD5] = request.security(syminfo.tickerid, tf5m, f_state())

// ─────────────────────────────────────────────────────────────────────────────
// Story hierarchy
// ─────────────────────────────────────────────────────────────────────────────
f_role(string parent, string child, int pb, int cb, string childLoc) =>
    cb == pb and cb != 0 ? child + " continues " + parent : childLoc == "Inside Supply" or childLoc == "Inside Demand" ? child + " decision inside " + parent : cb == 0 ? child + " building inside " + parent : pb != 0 and cb != pb ? child + " pullback against " + parent : child + " building inside " + parent

role1 = f_role("4H", "1H", b4, b1, loc1)
role15 = f_role("1H", "15M", b1, b15, loc15)
role5 = f_role("15M", "5M", b15, b5, loc5)

htfOk = loc4 != "Building KL memory"
oneOk = htfOk and (b1 == b4 or b1 == 0 or loc1 == "Inside Supply" or loc1 == "Inside Demand")
fifteenOk = oneOk and (b15 == b1 or b15 == b4 or b15 == 0 or loc15 == "Inside Supply" or loc15 == "Inside Demand")
fiveOk = fifteenOk and (b5 == b15 or b5 == 0 or loc5 == "Inside Supply" or loc5 == "Inside Demand")
execSide = loc5 == "Inside Supply" or b5 == -1 ? "5M supply" : loc5 == "Inside Demand" or b5 == 1 ? "5M demand" : "5M reaction"
executionStatus = not htfOk ? "EXEC WAIT: 4H story not clear" : not oneOk ? "EXEC WAIT: 1H not aligned" : not fifteenOk ? "EXEC WAIT: 15M not aligned" : execNeedsFullStory and not fiveOk ? "EXEC WAIT: 5M not aligned" : "EXEC WATCH: " + execSide + " inside story"
finalStory = loc4 == "Inside Supply" ? "4H SUPPLY DECISION STORY" : loc4 == "Inside Demand" ? "4H DEMAND DECISION STORY" : b4 == 1 ? "4H DEMAND STORY ACTIVE" : b4 == -1 ? "4H SUPPLY STORY ACTIVE" : "4H RANGE / BUILDING STORY"

// ─────────────────────────────────────────────────────────────────────────────
// Panel
// ─────────────────────────────────────────────────────────────────────────────
var table panel = table.new(f_pos(panelPos), 2, 14, border_width=1)
f_cell(int c, int r, string s, color bg) => table.cell(panel, c, r, s, bgcolor=bg, text_color=txtCol, text_size=panelMode == "Mobile" ? size.tiny : size.small)

if barstate.islast and showPanel
    table.clear(panel, 0, 0, 1, 13)
    f_cell(0, 0, "NCI x SMC", headBg)
    f_cell(1, 0, "v1.4.3.1.8", headBg)
    f_cell(0, 1, "Final", altBg)
    f_cell(1, 1, finalStory, altBg)
    f_cell(0, 2, "KL Source", rowBg)
    f_cell(1, 2, klSource, rowBg)
    f_cell(0, 3, "4H Location", rowBg)
    f_cell(1, 3, loc4, rowBg)
    f_cell(0, 4, "4H Event", rowBg)
    f_cell(1, 4, event4, rowBg)
    f_cell(0, 5, "4H Supply", rowBg)
    f_cell(1, 5, f_price(s4Bot) + " - " + f_price(s4Top) + " | " + srcS4 + " | " + sLife4, rowBg)
    f_cell(0, 6, "4H Demand", rowBg)
    f_cell(1, 6, f_price(d4Bot) + " - " + f_price(d4Top) + " | " + srcD4 + " | " + dLife4, rowBg)
    f_cell(0, 7, "Scores", rowBg)
    f_cell(1, 7, "S " + str.tostring(scoreS4) + " / D " + str.tostring(scoreD4), rowBg)
    f_cell(0, 8, "4H→1H", rowBg)
    f_cell(1, 8, role1, rowBg)
    f_cell(0, 9, "1H→15M", rowBg)
    f_cell(1, 9, role15, rowBg)
    f_cell(0, 10, "15M→5M", rowBg)
    f_cell(1, 10, role5, rowBg)
    f_cell(0, 11, "Execution", rowBg)
    f_cell(1, 11, executionStatus, rowBg)
    if panelMode == "Debug"
        f_cell(0, 12, "1H S/D", rowBg)
        f_cell(1, 12, f_price(s1Bot) + "-" + f_price(s1Top) + " / " + f_price(d1Bot) + "-" + f_price(d1Top), rowBg)
        f_cell(0, 13, "15M S/D", rowBg)
        f_cell(1, 13, f_price(s15Bot) + "-" + f_price(s15Top) + " / " + f_price(d15Bot) + "-" + f_price(d15Top), rowBg)

// ─────────────────────────────────────────────────────────────────────────────
// Visuals
// ─────────────────────────────────────────────────────────────────────────────
var box bs4 = na
var box bd4 = na
var box bs1 = na
var box bd1 = na
var box bs15 = na
var box bd15 = na
var box bs5 = na
var box bd5 = na
var label ls4 = na
var label ld4 = na
var label ls1 = na
var label ld1 = na
var label ls15 = na
var label ld15 = na
var label ls5 = na
var label ld5 = na

f_box(int leftT, float top, float bottom, color col, int tr) =>
    if f_zoneOk(top, bottom) and not na(leftT)
        box.new(left=leftT, top=top, right=f_rightTime(futureBars), bottom=bottom, xloc=xloc.bar_time, bgcolor=color.new(col, tr), border_color=color.new(col, 35), extend=extend.right)
    else
        na

f_lab(int off, float y, string s, string tip, color col, bool smallTxt) =>
    label.new(x=f_rightTime(off), y=y, text=s, tooltip=tip, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(col, 78), textcolor=color.black, size=smallTxt ? size.tiny : size.small)

f_tip(string tf, string side, float bot, float top, string source, string life, int score) =>
    tf + " " + side + "\nZone: " + f_price(bot) + " - " + f_price(top) + "\nSource: " + source + "\nLifecycle: " + life + "\nScore: " + str.tostring(score) + "\nExecution: " + executionStatus

chartM = f_chartMin()
showFull = visualMode == "Full" or visualMode == "Debug"
showStoryChildren = visualMode == "Story" ? chartM <= 60 : true
showExec = showExecZone and (execVisibility == "All timeframes" or execVisibility == "15M and below" and chartM <= 15 or execVisibility == "Execution TF only" and chartM <= 5)

if barstate.islast
    box.delete(bs4), box.delete(bd4), box.delete(bs1), box.delete(bd1), box.delete(bs15), box.delete(bd15), box.delete(bs5), box.delete(bd5)
    label.delete(ls4), label.delete(ld4), label.delete(ls1), label.delete(ld1), label.delete(ls15), label.delete(ld15), label.delete(ls5), label.delete(ld5)

    if show4h
        bs4 := f_box(s4Time, s4Top, s4Bot, color.fuchsia, 88)
        bd4 := f_box(d4Time, d4Top, d4Bot, color.aqua, 86)
        if f_zoneOk(s4Top, s4Bot)
            ls4 := f_lab(futureBars, (s4Top + s4Bot) / 2, "4H SUPPLY\n" + f_price(s4Bot) + " - " + f_price(s4Top), f_tip("4H", "Supply", s4Bot, s4Top, srcS4, sLife4, scoreS4), color.fuchsia, false)
        if f_zoneOk(d4Top, d4Bot)
            ld4 := f_lab(futureBars + 8, (d4Top + d4Bot) / 2, "4H DEMAND\n" + f_price(d4Bot) + " - " + f_price(d4Top), f_tip("4H", "Demand", d4Bot, d4Top, srcD4, dLife4, scoreD4), color.aqua, false)

    if show1h and showStoryChildren
        bs1 := f_box(s1Time, s1Top, s1Bot, color.red, showFull ? 91 : 95)
        bd1 := f_box(d1Time, d1Top, d1Bot, color.teal, showFull ? 91 : 95)
        if f_zoneOk(s1Top, s1Bot)
            ls1 := f_lab(futureBars + 16, (s1Top + s1Bot) / 2, compactLabels ? "1H SUP" : "1H SUPPLY", f_tip("1H", "Supply", s1Bot, s1Top, srcS1, sLife1, scoreS1), color.red, true)
        if f_zoneOk(d1Top, d1Bot)
            ld1 := f_lab(futureBars + 24, (d1Top + d1Bot) / 2, compactLabels ? "1H DEM" : "1H DEMAND", f_tip("1H", "Demand", d1Bot, d1Top, srcD1, dLife1, scoreD1), color.teal, true)

    if show15m and (showFull or chartM <= 15)
        bs15 := f_box(s15Time, s15Top, s15Bot, color.orange, 94)
        bd15 := f_box(d15Time, d15Top, d15Bot, color.green, 94)
        if f_zoneOk(s15Top, s15Bot)
            ls15 := f_lab(futureBars + 32, (s15Top + s15Bot) / 2, compactLabels ? "15M SUP" : "15M SUPPLY", f_tip("15M", "Supply", s15Bot, s15Top, srcS15, sLife15, scoreS15), color.orange, true)
        if f_zoneOk(d15Top, d15Bot)
            ld15 := f_lab(futureBars + 40, (d15Top + d15Bot) / 2, compactLabels ? "15M DEM" : "15M DEMAND", f_tip("15M", "Demand", d15Bot, d15Top, srcD15, dLife15, scoreD15), color.green, true)

    if show5m and showExec
        bs5 := f_box(s5Time, s5Top, s5Bot, color.yellow, 95)
        bd5 := f_box(d5Time, d5Top, d5Bot, color.lime, 95)
        if f_zoneOk(s5Top, s5Bot)
            ls5 := f_lab(futureBars + 48, (s5Top + s5Bot) / 2, compactLabels ? "5M EXEC SUP" : "5M EXEC SUPPLY", f_tip("5M", "Execution Supply", s5Bot, s5Top, srcS5, sLife5, scoreS5), color.yellow, true)
        if f_zoneOk(d5Top, d5Bot)
            ld5 := f_lab(futureBars + 56, (d5Top + d5Bot) / 2, compactLabels ? "5M EXEC DEM" : "5M EXEC DEMAND", f_tip("5M", "Execution Demand", d5Bot, d5Top, srcD5, dLife5, scoreD5), color.lime, true)
