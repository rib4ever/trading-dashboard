//@version=6
indicator("NCI x SMC Market Story Visualizer [Ravi Custom] v1.4.3.3", shorttitle="NCIStory", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=250, max_bars_back=1500)

// v1.4.3.3 — Full Core-Mind Merge
// Base: v1.4.3 visual behavior and BOS-required KL logic.
// Merged carefully:
// - confirmed KL search engine: rejected latest candidate does not replace confirmed KL
// - NCI draw classification in labels/tooltips
// - 4H/1H/15M/5M hierarchy from core mind map
// - Story/Full/Debug visual modes
// - Debug-only rejected candidates
// - Inside zone is decision/wait, not execution
//
// Important: this is an experimental full-merge build, not a simplified rewrite.

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
grpTF = "01. TF Story Stack"
tf4h  = input.timeframe("240", "Master TF", group=grpTF)
tf1h  = input.timeframe("60", "Child TF 1", group=grpTF)
tf15m = input.timeframe("15", "Child TF 2", group=grpTF)
tf5m  = input.timeframe("5", "Execution TF", group=grpTF)

grpL = "02. NCI + SMC KL Engine"
swingLen        = input.int(5, "Structure Swing Length", minval=2, maxval=20, group=grpL)
atrLen          = input.int(14, "ATR Length", minval=1, group=grpL)
searchDepth     = input.int(8, "Raw Candidate Search Depth", minval=2, maxval=8, group=grpL)
confirmedDepth  = input.int(5, "Confirmed BOS-Origin KL Search Depth", minval=1, maxval=5, group=grpL)
requireBOS      = input.bool(true, "Require BOS to Create KL", group=grpL)
bosUseClose     = input.bool(false, "BOS Requires Close Beyond Structure", group=grpL)
bosBufferAtr    = input.float(0.05, "BOS Buffer ATR", minval=0.0, maxval=2.0, step=0.01, group=grpL)
activeBufferAtr = input.float(0.05, "Active / Broken Buffer ATR", minval=0.0, maxval=1.0, step=0.01, group=grpL)
showRejected    = input.bool(true, "Show NOT KL only when no confirmed KL", group=grpL)
hugeBodyRatio   = input.float(0.70, "Huge Body Ratio", minval=0.50, maxval=0.95, step=0.05, group=grpL)
wickBodyRatio   = input.float(1.50, "Huge Wick vs Body Ratio", minval=0.50, maxval=5.0, step=0.10, group=grpL)
minZoneAtr      = input.float(0.06, "Minimum Zone Thickness ATR", minval=0.01, maxval=1.0, step=0.01, group=grpL)

grpV = "03. Visuals"
showPanel      = input.bool(true, "Show Story Panel", group=grpV)
show4h         = input.bool(true, "Show 4H Master KL", group=grpV)
show1h         = input.bool(true, "Show 1H Context", group=grpV)
show15m        = input.bool(true, "Show 15M Context", group=grpV)
show5m         = input.bool(true, "Show 5M Context", group=grpV)
showChildren   = input.bool(true, "Show Child Context Zones", group=grpV)
visualMode     = input.string("Story", "Visual Mode", options=["Story", "Full", "Debug"], group=grpV)
showStoryLabel = input.bool(false, "Show Floating Story Label", group=grpV)
compactLabels  = input.bool(true, "Compact Child Labels", group=grpV)
showEventTags  = input.bool(true, "Show SMC Event Tag", group=grpV)
futureBars     = input.int(50, "Right Label Offset", minval=10, maxval=250, group=grpV)
theme          = input.string("Light", "Theme", options=["Light", "Dark"], group=grpV)
panelPos       = input.string("Top Right", "Panel Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpV)
panelMode      = input.string("Mobile", "Panel Mode", options=["Mobile", "Normal", "Debug"], group=grpV)

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────────────
isLight = theme == "Light"
txtCol = isLight ? color.black : color.white
headBg = isLight ? color.new(color.silver, 10) : color.new(color.black, 0)
rowBg  = isLight ? color.new(color.white, 74) : color.new(color.gray, 86)
altBg  = isLight ? color.new(color.silver, 86) : color.new(color.gray, 90)

f_pos(string p) => p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : position.top_right
f_price(float x) => na(x) ? "n/a" : str.tostring(x, format.mintick)
f_rightTime(int barsForward) => time + timeframe.in_seconds(timeframe.period) * 1000 * barsForward
f_body(float o, float c) => math.abs(c - o)
f_rng(float h, float l) => math.max(h - l, syminfo.mintick)
f_bodyRatio(float o, float h, float l, float c) => f_body(o, c) / f_rng(h, l)
f_inside(float top, float bot) => not na(top) and not na(bot) and close <= top and close >= bot
f_chartMin() => timeframe.isminutes ? timeframe.multiplier : timeframe.isseconds ? 1 : timeframe.isdaily ? 1440 : timeframe.isweekly ? 10080 : 240

// ─────────────────────────────────────────────────────────────────────────────
// NCI zone drawing helpers
// ─────────────────────────────────────────────────────────────────────────────
f_supplyBottom(float o, float h, float l, float c, float atr) =>
    body = math.max(f_body(o, c), syminfo.mintick)
    upperWick = h - math.max(o, c)
    br = f_bodyRatio(o, h, l, c)
    hugeWick = upperWick >= body * wickBodyRatio
    hugeBody = br >= hugeBodyRatio
    bot = hugeWick ? h - upperWick * 0.50 : hugeBody ? math.max(o, c) : math.min(o, c)
    math.min(bot, h - atr * minZoneAtr)

f_demandTop(float o, float h, float l, float c, float atr) =>
    body = math.max(f_body(o, c), syminfo.mintick)
    lowerWick = math.min(o, c) - l
    br = f_bodyRatio(o, h, l, c)
    hugeWick = lowerWick >= body * wickBodyRatio
    hugeBody = br >= hugeBodyRatio
    top = hugeWick ? l + lowerWick * 0.50 : hugeBody ? math.min(o, c) : math.max(o, c)
    math.max(top, l + atr * minZoneAtr)

f_zoneType(float o, float h, float l, float c, bool supplySide) =>
    body = math.max(f_body(o, c), syminfo.mintick)
    upperWick = h - math.max(o, c)
    lowerWick = math.min(o, c) - l
    br = f_bodyRatio(o, h, l, c)
    wick = supplySide ? upperWick : lowerWick
    wick >= body * wickBodyRatio ? "Long wick / half-wick" : br >= hugeBodyRatio ? "Huge body" : "Normal candle"

// ─────────────────────────────────────────────────────────────────────────────
// Confirmed KL search engine per timeframe
// Return:
// supplyTop, supplyBot, supplyTime, supplyConfirmed, supplyNote,
// demandTop, demandBot, demandTime, demandConfirmed, demandNote,
// bias, story, cycle, event, inSupply, inDemand, supplyType, demandType
// ─────────────────────────────────────────────────────────────────────────────
f_state() =>
    atr = ta.atr(atrLen)
    ph = ta.pivothigh(high, swingLen, swingLen)
    pl = ta.pivotlow(low, swingLen, swingLen)

    // Swing memory — explicit variables are intentional for Pine security stability.
    ph0 = ta.valuewhen(not na(ph), ph, 0)
    ph1 = ta.valuewhen(not na(ph), ph, 1)
    ph2 = ta.valuewhen(not na(ph), ph, 2)
    ph3 = ta.valuewhen(not na(ph), ph, 3)
    ph4 = ta.valuewhen(not na(ph), ph, 4)
    ph5 = ta.valuewhen(not na(ph), ph, 5)
    ph6 = ta.valuewhen(not na(ph), ph, 6)
    ph7 = ta.valuewhen(not na(ph), ph, 7)
    pl0 = ta.valuewhen(not na(pl), pl, 0)
    pl1 = ta.valuewhen(not na(pl), pl, 1)
    pl2 = ta.valuewhen(not na(pl), pl, 2)
    pl3 = ta.valuewhen(not na(pl), pl, 3)
    pl4 = ta.valuewhen(not na(pl), pl, 4)
    pl5 = ta.valuewhen(not na(pl), pl, 5)
    pl6 = ta.valuewhen(not na(pl), pl, 6)
    pl7 = ta.valuewhen(not na(pl), pl, 7)

    phT0 = ta.valuewhen(not na(ph), time[swingLen], 0)
    phT1 = ta.valuewhen(not na(ph), time[swingLen], 1)
    phT2 = ta.valuewhen(not na(ph), time[swingLen], 2)
    phT3 = ta.valuewhen(not na(ph), time[swingLen], 3)
    phT4 = ta.valuewhen(not na(ph), time[swingLen], 4)
    phT5 = ta.valuewhen(not na(ph), time[swingLen], 5)
    phT6 = ta.valuewhen(not na(ph), time[swingLen], 6)
    phT7 = ta.valuewhen(not na(ph), time[swingLen], 7)
    plT0 = ta.valuewhen(not na(pl), time[swingLen], 0)
    plT1 = ta.valuewhen(not na(pl), time[swingLen], 1)
    plT2 = ta.valuewhen(not na(pl), time[swingLen], 2)
    plT3 = ta.valuewhen(not na(pl), time[swingLen], 3)
    plT4 = ta.valuewhen(not na(pl), time[swingLen], 4)
    plT5 = ta.valuewhen(not na(pl), time[swingLen], 5)
    plT6 = ta.valuewhen(not na(pl), time[swingLen], 6)
    plT7 = ta.valuewhen(not na(pl), time[swingLen], 7)

    phO0 = ta.valuewhen(not na(ph), open[swingLen], 0)
    phO1 = ta.valuewhen(not na(ph), open[swingLen], 1)
    phO2 = ta.valuewhen(not na(ph), open[swingLen], 2)
    phO3 = ta.valuewhen(not na(ph), open[swingLen], 3)
    phO4 = ta.valuewhen(not na(ph), open[swingLen], 4)
    phO5 = ta.valuewhen(not na(ph), open[swingLen], 5)
    phO6 = ta.valuewhen(not na(ph), open[swingLen], 6)
    phO7 = ta.valuewhen(not na(ph), open[swingLen], 7)
    phL0 = ta.valuewhen(not na(ph), low[swingLen], 0)
    phL1 = ta.valuewhen(not na(ph), low[swingLen], 1)
    phL2 = ta.valuewhen(not na(ph), low[swingLen], 2)
    phL3 = ta.valuewhen(not na(ph), low[swingLen], 3)
    phL4 = ta.valuewhen(not na(ph), low[swingLen], 4)
    phL5 = ta.valuewhen(not na(ph), low[swingLen], 5)
    phL6 = ta.valuewhen(not na(ph), low[swingLen], 6)
    phL7 = ta.valuewhen(not na(ph), low[swingLen], 7)
    phC0 = ta.valuewhen(not na(ph), close[swingLen], 0)
    phC1 = ta.valuewhen(not na(ph), close[swingLen], 1)
    phC2 = ta.valuewhen(not na(ph), close[swingLen], 2)
    phC3 = ta.valuewhen(not na(ph), close[swingLen], 3)
    phC4 = ta.valuewhen(not na(ph), close[swingLen], 4)
    phC5 = ta.valuewhen(not na(ph), close[swingLen], 5)
    phC6 = ta.valuewhen(not na(ph), close[swingLen], 6)
    phC7 = ta.valuewhen(not na(ph), close[swingLen], 7)

    plO0 = ta.valuewhen(not na(pl), open[swingLen], 0)
    plO1 = ta.valuewhen(not na(pl), open[swingLen], 1)
    plO2 = ta.valuewhen(not na(pl), open[swingLen], 2)
    plO3 = ta.valuewhen(not na(pl), open[swingLen], 3)
    plO4 = ta.valuewhen(not na(pl), open[swingLen], 4)
    plO5 = ta.valuewhen(not na(pl), open[swingLen], 5)
    plO6 = ta.valuewhen(not na(pl), open[swingLen], 6)
    plO7 = ta.valuewhen(not na(pl), open[swingLen], 7)
    plH0 = ta.valuewhen(not na(pl), high[swingLen], 0)
    plH1 = ta.valuewhen(not na(pl), high[swingLen], 1)
    plH2 = ta.valuewhen(not na(pl), high[swingLen], 2)
    plH3 = ta.valuewhen(not na(pl), high[swingLen], 3)
    plH4 = ta.valuewhen(not na(pl), high[swingLen], 4)
    plH5 = ta.valuewhen(not na(pl), high[swingLen], 5)
    plH6 = ta.valuewhen(not na(pl), high[swingLen], 6)
    plH7 = ta.valuewhen(not na(pl), high[swingLen], 7)
    plC0 = ta.valuewhen(not na(pl), close[swingLen], 0)
    plC1 = ta.valuewhen(not na(pl), close[swingLen], 1)
    plC2 = ta.valuewhen(not na(pl), close[swingLen], 2)
    plC3 = ta.valuewhen(not na(pl), close[swingLen], 3)
    plC4 = ta.valuewhen(not na(pl), close[swingLen], 4)
    plC5 = ta.valuewhen(not na(pl), close[swingLen], 5)
    plC6 = ta.valuewhen(not na(pl), close[swingLen], 6)
    plC7 = ta.valuewhen(not na(pl), close[swingLen], 7)

    // Raw candidate zones from NCI zone builder alpha.
    sb0 = f_supplyBottom(phO0, ph0, phL0, phC0, atr)
    sb1 = f_supplyBottom(phO1, ph1, phL1, phC1, atr)
    sb2 = f_supplyBottom(phO2, ph2, phL2, phC2, atr)
    sb3 = f_supplyBottom(phO3, ph3, phL3, phC3, atr)
    sb4 = f_supplyBottom(phO4, ph4, phL4, phC4, atr)
    sb5 = f_supplyBottom(phO5, ph5, phL5, phC5, atr)
    sb6 = f_supplyBottom(phO6, ph6, phL6, phC6, atr)
    sb7 = f_supplyBottom(phO7, ph7, phL7, phC7, atr)
    dt0 = f_demandTop(plO0, plH0, pl0, plC0, atr)
    dt1 = f_demandTop(plO1, plH1, pl1, plC1, atr)
    dt2 = f_demandTop(plO2, plH2, pl2, plC2, atr)
    dt3 = f_demandTop(plO3, plH3, pl3, plC3, atr)
    dt4 = f_demandTop(plO4, plH4, pl4, plC4, atr)
    dt5 = f_demandTop(plO5, plH5, pl5, plC5, atr)
    dt6 = f_demandTop(plO6, plH6, pl6, plC6, atr)
    dt7 = f_demandTop(plO7, plH7, pl7, plC7, atr)

    // BOS confirmation: SMC structure supports NCI KL validation.
    bullBOS = not na(ph1) and (bosUseClose ? close > ph1 + atr * bosBufferAtr : high > ph1 + atr * bosBufferAtr)
    bearBOS = not na(pl1) and (bosUseClose ? close < pl1 - atr * bosBufferAtr : low < pl1 - atr * bosBufferAtr)

    // BOS-origin zones captured at moment of structure break.
    cDTop0 = ta.valuewhen(bullBOS, dt0, 0)
    cDTop1 = ta.valuewhen(bullBOS, dt0, 1)
    cDTop2 = ta.valuewhen(bullBOS, dt0, 2)
    cDTop3 = ta.valuewhen(bullBOS, dt0, 3)
    cDTop4 = ta.valuewhen(bullBOS, dt0, 4)
    cDBot0 = ta.valuewhen(bullBOS, pl0, 0)
    cDBot1 = ta.valuewhen(bullBOS, pl0, 1)
    cDBot2 = ta.valuewhen(bullBOS, pl0, 2)
    cDBot3 = ta.valuewhen(bullBOS, pl0, 3)
    cDBot4 = ta.valuewhen(bullBOS, pl0, 4)
    cDTime0 = ta.valuewhen(bullBOS, plT0, 0)
    cDTime1 = ta.valuewhen(bullBOS, plT0, 1)
    cDTime2 = ta.valuewhen(bullBOS, plT0, 2)
    cDTime3 = ta.valuewhen(bullBOS, plT0, 3)
    cDTime4 = ta.valuewhen(bullBOS, plT0, 4)

    cSTop0 = ta.valuewhen(bearBOS, ph0, 0)
    cSTop1 = ta.valuewhen(bearBOS, ph0, 1)
    cSTop2 = ta.valuewhen(bearBOS, ph0, 2)
    cSTop3 = ta.valuewhen(bearBOS, ph0, 3)
    cSTop4 = ta.valuewhen(bearBOS, ph0, 4)
    cSBot0 = ta.valuewhen(bearBOS, sb0, 0)
    cSBot1 = ta.valuewhen(bearBOS, sb0, 1)
    cSBot2 = ta.valuewhen(bearBOS, sb0, 2)
    cSBot3 = ta.valuewhen(bearBOS, sb0, 3)
    cSBot4 = ta.valuewhen(bearBOS, sb0, 4)
    cSTime0 = ta.valuewhen(bearBOS, phT0, 0)
    cSTime1 = ta.valuewhen(bearBOS, phT0, 1)
    cSTime2 = ta.valuewhen(bearBOS, phT0, 2)
    cSTime3 = ta.valuewhen(bearBOS, phT0, 3)
    cSTime4 = ta.valuewhen(bearBOS, phT0, 4)

    // Search backward for the nearest still-active confirmed KL.
    s0ok = confirmedDepth > 0 and not na(cSTop0) and close <= cSTop0 + atr * activeBufferAtr
    s1ok = confirmedDepth > 1 and not na(cSTop1) and close <= cSTop1 + atr * activeBufferAtr
    s2ok = confirmedDepth > 2 and not na(cSTop2) and close <= cSTop2 + atr * activeBufferAtr
    s3ok = confirmedDepth > 3 and not na(cSTop3) and close <= cSTop3 + atr * activeBufferAtr
    s4ok = confirmedDepth > 4 and not na(cSTop4) and close <= cSTop4 + atr * activeBufferAtr
    d0ok = confirmedDepth > 0 and not na(cDBot0) and close >= cDBot0 - atr * activeBufferAtr
    d1ok = confirmedDepth > 1 and not na(cDBot1) and close >= cDBot1 - atr * activeBufferAtr
    d2ok = confirmedDepth > 2 and not na(cDBot2) and close >= cDBot2 - atr * activeBufferAtr
    d3ok = confirmedDepth > 3 and not na(cDBot3) and close >= cDBot3 - atr * activeBufferAtr
    d4ok = confirmedDepth > 4 and not na(cDBot4) and close >= cDBot4 - atr * activeBufferAtr

    sConf = s0ok or s1ok or s2ok or s3ok or s4ok
    dConf = d0ok or d1ok or d2ok or d3ok or d4ok

    // Latest raw candidate fallback if confirmed search fails.
    rawS0ok = searchDepth > 0 and not na(ph0) and close <= ph0 + atr * activeBufferAtr
    rawD0ok = searchDepth > 0 and not na(pl0) and close >= pl0 - atr * activeBufferAtr

    sTop = sConf ? (s0ok ? cSTop0 : s1ok ? cSTop1 : s2ok ? cSTop2 : s3ok ? cSTop3 : cSTop4) : ph0
    sBot = sConf ? (s0ok ? cSBot0 : s1ok ? cSBot1 : s2ok ? cSBot2 : s3ok ? cSBot3 : cSBot4) : sb0
    sTime = sConf ? (s0ok ? cSTime0 : s1ok ? cSTime1 : s2ok ? cSTime2 : s3ok ? cSTime3 : cSTime4) : phT0
    dTop = dConf ? (d0ok ? cDTop0 : d1ok ? cDTop1 : d2ok ? cDTop2 : d3ok ? cDTop3 : cDTop4) : dt0
    dBot = dConf ? (d0ok ? cDBot0 : d1ok ? cDBot1 : d2ok ? cDBot2 : d3ok ? cDBot3 : cDBot4) : pl0
    dTime = dConf ? (d0ok ? cDTime0 : d1ok ? cDTime1 : d2ok ? cDTime2 : d3ok ? cDTime3 : cDTime4) : plT0

    inS = f_inside(sTop, sBot)
    inD = f_inside(dTop, dBot)
    hasBoth = not na(sTop) and not na(dBot)
    mid = hasBoth ? (sBot + dTop) / 2.0 : close
    int bias = not hasBoth ? 0 : inS or inD ? 0 : close > sTop ? 1 : close < dBot ? -1 : close >= mid ? -1 : 1

    sNote = sConf ? "confirmed KL" : rawS0ok ? "not KL: latest supply candidate lacks active BOS-origin confirmation" : "no supply candidate"
    dNote = dConf ? "confirmed KL" : rawD0ok ? "not KL: latest demand candidate lacks active BOS-origin confirmation" : "no demand candidate"
    story = inS and sConf ? "At confirmed supply KL" : inD and dConf ? "At confirmed demand KL" : sConf and dConf ? (bias == -1 ? "Supply story active" : bias == 1 ? "Demand story active" : "Inside confirmed KL range") : "Searching confirmed KL; latest candidate is not KL"
    cycle = inS or inD ? "Decision" : bullBOS ? "Bullish BOS" : bearBOS ? "Bearish BOS" : bias == 1 ? "Pullback above demand" : bias == -1 ? "Pullback below supply" : "Range / Building"
    event = bullBOS ? "BOS UP" : bearBOS ? "BOS DOWN" : inS ? "Supply decision" : inD ? "Demand decision" : "No fresh event"
    sType = f_zoneType(phO0, ph0, phL0, phC0, true)
    dType = f_zoneType(plO0, plH0, pl0, plC0, false)

    [sTop, sBot, sTime, sConf, sNote, dTop, dBot, dTime, dConf, dNote, bias, story, cycle, event, inS, inD, sType, dType]

// ─────────────────────────────────────────────────────────────────────────────
// Multi-timeframe story stack
// ─────────────────────────────────────────────────────────────────────────────
[s4Top, s4Bot, s4Time, s4Conf, s4Note, d4Top, d4Bot, d4Time, d4Conf, d4Note, b4, story4, cycle4, event4, inS4, inD4, sType4, dType4] = request.security(syminfo.tickerid, tf4h, f_state())
[s1Top, s1Bot, s1Time, s1Conf, s1Note, d1Top, d1Bot, d1Time, d1Conf, d1Note, b1, story1, cycle1, event1, inS1, inD1, sType1, dType1] = request.security(syminfo.tickerid, tf1h, f_state())
[s15Top, s15Bot, s15Time, s15Conf, s15Note, d15Top, d15Bot, d15Time, d15Conf, d15Note, b15, story15, cycle15, event15, inS15, inD15, sType15, dType15] = request.security(syminfo.tickerid, tf15m, f_state())
[s5Top, s5Bot, s5Time, s5Conf, s5Note, d5Top, d5Bot, d5Time, d5Conf, d5Note, b5, story5, cycle5, event5, inS5, inD5, sType5, dType5] = request.security(syminfo.tickerid, tf5m, f_state())

role1 = s1Conf or d1Conf ? (b1 == b4 ? "1H explains 4H" : "1H pullback / transition") : "1H candidate only"
role15 = s15Conf or d15Conf ? (b15 == b1 ? "15M explains 1H" : "15M counter-move") : "15M candidate only"
role5 = s5Conf or d5Conf ? (b5 == b15 ? "5M execution aligns" : "5M local reaction") : "5M candidate only"
finalStory = inS4 and s4Conf ? "4H SUPPLY DECISION ACTIVE" : inD4 and d4Conf ? "4H DEMAND DECISION ACTIVE" : b4 == -1 and s4Conf ? "4H SUPPLY STORY ACTIVE" : b4 == 1 and d4Conf ? "4H DEMAND STORY ACTIVE" : "WAIT: confirmed KL search"
confidence = s4Conf or d4Conf ? "Confirmed KL found by BOS-origin search" : "No confirmed 4H KL in search; showing candidate"

// ─────────────────────────────────────────────────────────────────────────────
// Panel
// ─────────────────────────────────────────────────────────────────────────────
var table panel = table.new(f_pos(panelPos), 2, 18, border_width=1)
f_cell(int c, int r, string s, color bg) => table.cell(panel, c, r, s, bgcolor=bg, text_color=txtCol, text_size=panelMode == "Mobile" ? size.tiny : size.small)

if barstate.islast and showPanel
    table.clear(panel, 0, 0, 1, 17)
    f_cell(0, 0, "NCI x SMC", headBg)
    f_cell(1, 0, "v1.4.3.3", headBg)
    f_cell(0, 1, "Final", altBg)
    f_cell(1, 1, finalStory, altBg)
    f_cell(0, 2, "Confidence", rowBg)
    f_cell(1, 2, confidence, rowBg)
    f_cell(0, 3, "4H Master", rowBg)
    f_cell(1, 3, story4, rowBg)
    f_cell(0, 4, "4H Cycle", rowBg)
    f_cell(1, 4, cycle4, rowBg)
    f_cell(0, 5, "SMC Event", rowBg)
    f_cell(1, 5, event4, rowBg)
    f_cell(0, 6, "1H Role", rowBg)
    f_cell(1, 6, role1, rowBg)
    f_cell(0, 7, "15M Role", rowBg)
    f_cell(1, 7, role15, rowBg)
    f_cell(0, 8, "5M Role", rowBg)
    f_cell(1, 8, role5, rowBg)
    f_cell(0, 9, "4H Supply", rowBg)
    f_cell(1, 9, f_price(s4Bot) + " - " + f_price(s4Top) + " | " + (s4Conf ? "KL" : "not KL"), rowBg)
    f_cell(0, 10, "4H Demand", rowBg)
    f_cell(1, 10, f_price(d4Bot) + " - " + f_price(d4Top) + " | " + (d4Conf ? "KL" : "not KL"), rowBg)
    if panelMode == "Debug"
        f_cell(0, 11, "SUP reason", rowBg)
        f_cell(1, 11, s4Note, rowBg)
        f_cell(0, 12, "DEM reason", rowBg)
        f_cell(1, 12, d4Note, rowBg)
        f_cell(0, 13, "SUP draw", rowBg)
        f_cell(1, 13, sType4, rowBg)
        f_cell(0, 14, "DEM draw", rowBg)
        f_cell(1, 14, dType4, rowBg)

// ─────────────────────────────────────────────────────────────────────────────
// Visuals
// ─────────────────────────────────────────────────────────────────────────────
var box bs4 = na
var box bd4 = na
var box bs1 = na
var box bd1 = na
var box bs15 = na
var box bd15 = na
var box bs5 = na
var box bd5 = na
var label ls4 = na
var label ld4 = na
var label ls1 = na
var label ld1 = na
var label ls15 = na
var label ld15 = na
var label ls5 = na
var label ld5 = na
var label evLab = na
var label stLab = na

f_box(int leftT, float top, float bottom, color col, int tr) =>
    box.new(left=leftT, top=top, right=f_rightTime(futureBars), bottom=bottom, xloc=xloc.bar_time, bgcolor=color.new(col, tr), border_color=color.new(col, 35), extend=extend.right)

f_lab(int off, float y, string s, string tip, color col, bool smallTxt) =>
    label.new(x=f_rightTime(off), y=y, text=s, tooltip=tip, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(col, 78), textcolor=color.black, size=smallTxt ? size.tiny : size.small)

f_tip(string tf, string side, float bot, float top, string zoneType, string cycle, string event, string note, bool inside) =>
    tf + " " + side + "\nZone: " + f_price(bot) + " - " + f_price(top) + "\nNCI draw: " + zoneType + "\nCycle: " + cycle + "\nSMC: " + event + "\nStatus: " + note + "\nPosition: " + (inside ? "inside decision" : "active/reference")

chartM = f_chartMin()
showFull = visualMode == "Full" or visualMode == "Debug"
showStoryChildren = visualMode == "Story" ? chartM <= 60 : true

if barstate.islast
    box.delete(bs4), box.delete(bd4), box.delete(bs1), box.delete(bd1), box.delete(bs15), box.delete(bd15), box.delete(bs5), box.delete(bd5)
    label.delete(ls4), label.delete(ld4), label.delete(ls1), label.delete(ld1), label.delete(ls15), label.delete(ld15), label.delete(ls5), label.delete(ld5), label.delete(evLab), label.delete(stLab)

    showS4 = show4h and not na(s4Time) and not na(s4Top) and not na(s4Bot) and (s4Conf or showRejected)
    showD4 = show4h and not na(d4Time) and not na(d4Top) and not na(d4Bot) and (d4Conf or showRejected)

    if showS4
        bs4 := f_box(s4Time, s4Top, s4Bot, color.fuchsia, s4Conf ? 88 : 95)
        ls4 := f_lab(futureBars, (s4Top + s4Bot) / 2, (s4Conf ? "4H SUPPLY\n" : "4H not KL\n") + f_price(s4Bot) + " - " + f_price(s4Top), f_tip("4H", "Supply", s4Bot, s4Top, sType4, cycle4, event4, s4Note, inS4), color.fuchsia, false)
    if showD4
        bd4 := f_box(d4Time, d4Top, d4Bot, color.aqua, d4Conf ? 86 : 95)
        ld4 := f_lab(futureBars + 8, (d4Top + d4Bot) / 2, (d4Conf ? "4H DEMAND\n" : "4H not KL\n") + f_price(d4Bot) + " - " + f_price(d4Top), f_tip("4H", "Demand", d4Bot, d4Top, dType4, cycle4, event4, d4Note, inD4), color.aqua, false)

    if showChildren and show1h and showStoryChildren and not na(s1Time) and not na(s1Top) and not na(s1Bot) and (s1Conf or visualMode == "Debug")
        bs1 := f_box(s1Time, s1Top, s1Bot, color.red, s1Conf ? (showFull ? 91 : 95) : 97)
        ls1 := f_lab(futureBars + 16, (s1Top + s1Bot) / 2, s1Conf ? (compactLabels ? "1H SUP" : "1H SUPPLY") : "1H not KL", f_tip("1H", "Supply", s1Bot, s1Top, sType1, cycle1, event1, s1Note, inS1), color.red, true)
    if showChildren and show1h and showStoryChildren and not na(d1Time) and not na(d1Top) and not na(d1Bot) and (d1Conf or visualMode == "Debug")
        bd1 := f_box(d1Time, d1Top, d1Bot, color.teal, d1Conf ? (showFull ? 91 : 95) : 97)
        ld1 := f_lab(futureBars + 24, (d1Top + d1Bot) / 2, d1Conf ? (compactLabels ? "1H DEM" : "1H DEMAND") : "1H not KL", f_tip("1H", "Demand", d1Bot, d1Top, dType1, cycle1, event1, d1Note, inD1), color.teal, true)

    if showChildren and show15m and (showFull or chartM <= 15) and not na(s15Time) and not na(s15Top) and not na(s15Bot) and (s15Conf or visualMode == "Debug")
        bs15 := f_box(s15Time, s15Top, s15Bot, color.orange, s15Conf ? 94 : 97)
        ls15 := f_lab(futureBars + 32, (s15Top + s15Bot) / 2, s15Conf ? (compactLabels ? "15M SUP" : "15M SUPPLY") : "15M not KL", f_tip("15M", "Supply", s15Bot, s15Top, sType15, cycle15, event15, s15Note, inS15), color.orange, true)
    if showChildren and show15m and (showFull or chartM <= 15) and not na(d15Time) and not na(d15Top) and not na(d15Bot) and (d15Conf or visualMode == "Debug")
        bd15 := f_box(d15Time, d15Top, d15Bot, color.green, d15Conf ? 94 : 97)
        ld15 := f_lab(futureBars + 40, (d15Top + d15Bot) / 2, d15Conf ? (compactLabels ? "15M DEM" : "15M DEMAND") : "15M not KL", f_tip("15M", "Demand", d15Bot, d15Top, dType15, cycle15, event15, d15Note, inD15), color.green, true)

    if showChildren and show5m and (showFull or chartM <= 5) and not na(s5Time) and not na(s5Top) and not na(s5Bot) and (s5Conf or visualMode == "Debug")
        bs5 := f_box(s5Time, s5Top, s5Bot, color.yellow, s5Conf ? 96 : 98)
        ls5 := f_lab(futureBars + 48, (s5Top + s5Bot) / 2, s5Conf ? (compactLabels ? "5M SUP" : "5M SUPPLY") : "5M not KL", f_tip("5M", "Supply", s5Bot, s5Top, sType5, cycle5, event5, s5Note, inS5), color.yellow, true)
    if showChildren and show5m and (showFull or chartM <= 5) and not na(d5Time) and not na(d5Top) and not na(d5Bot) and (d5Conf or visualMode == "Debug")
        bd5 := f_box(d5Time, d5Top, d5Bot, color.lime, d5Conf ? 96 : 98)
        ld5 := f_lab(futureBars + 56, (d5Top + d5Bot) / 2, d5Conf ? (compactLabels ? "5M DEM" : "5M DEMAND") : "5M not KL", f_tip("5M", "Demand", d5Bot, d5Top, dType5, cycle5, event5, d5Note, inD5), color.lime, true)

    if showEventTags
        evCol = event4 == "BOS UP" ? color.green : event4 == "BOS DOWN" ? color.red : color.gray
        evLab := f_lab(futureBars + 14, close, "SMC\n" + event4, "4H event: " + event4 + "\nCycle: " + cycle4 + "\nRule: rejected candidate does not replace confirmed KL.", evCol, true)

    if showStoryLabel
        stLab := f_lab(futureBars + 22, close, "NCI STORY\n" + finalStory, "v1.4.3.3 full core-mind merge. 4H master story controls child TF context.", color.gray, false)
