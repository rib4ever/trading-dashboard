//@version=6
indicator("NCI x SMC Market Story Visualizer [Ravi Custom] v1.4.4", shorttitle="NCIStory", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=250, max_bars_back=1500)

// v1.4.4 — Reaction Candle Validation + Inside-Zone Decision Logic
// Core priority order:
// 1) 4H master story is always the anchor.
// 2) A KL must be BOS-created when the option is ON.
// 3) After the KL candle/base, reaction candles must prove pressure when the option is ON.
// 4) If price is inside the zone, it is a decision zone, not clean execution.
// 5) Lower TFs explain the higher TF story; they do not override it alone.

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
grpTF = "01. TF Story Stack"
tf4h  = input.timeframe("240", "Master TF", group=grpTF)
tf1h  = input.timeframe("60", "Child TF 1", group=grpTF)
tf15m = input.timeframe("15", "Child TF 2", group=grpTF)
tf5m  = input.timeframe("5", "Execution TF", group=grpTF)

grpL = "02. NCI Logic"
swingLen          = input.int(5, "Swing Length", minval=4, maxval=20, group=grpL)
atrLen            = input.int(14, "ATR Length", minval=1, group=grpL)
searchDepth       = input.int(8, "KL Search Depth", minval=2, maxval=8, group=grpL)
requireBOS        = input.bool(true, "Require BOS to Create KL", group=grpL)
bosUseClose       = input.bool(false, "BOS Requires Close Beyond Structure", group=grpL)
bosBufferAtr      = input.float(0.05, "BOS Buffer ATR", minval=0.0, maxval=2.0, step=0.01, group=grpL)
requireReaction   = input.bool(true, "Require Reaction Candles After KL", group=grpL)
reactionBars      = input.int(3, "Reaction Candle Count", minval=2, maxval=4, group=grpL)
minReactionScore  = input.int(3, "Minimum Reaction Score", minval=1, maxval=5, group=grpL)
insideZoneFilter  = input.bool(true, "Inside Zone = Decision, Not Execution", group=grpL)
mitigateAtr       = input.float(0.05, "Break/Mitigation Buffer ATR", minval=0.0, maxval=1.0, step=0.01, group=grpL)
reentryAtr        = input.float(0.10, "Deep Re-entry Buffer ATR", minval=0.0, maxval=1.0, step=0.01, group=grpL)
hugeBodyRatio     = input.float(0.70, "Huge Body Ratio", minval=0.50, maxval=0.95, step=0.05, group=grpL)
wickBodyRatio     = input.float(1.50, "Huge Wick vs Body Ratio", minval=0.50, maxval=5.0, step=0.10, group=grpL)
minZoneAtr        = input.float(0.06, "Minimum Zone Thickness ATR", minval=0.01, maxval=1.0, step=0.01, group=grpL)

grpV = "03. Visuals"
showPanel      = input.bool(true, "Show Story Panel", group=grpV)
show4h         = input.bool(true, "Show 4H Master KL", group=grpV)
show1h         = input.bool(true, "Show 1H Context", group=grpV)
show15m        = input.bool(true, "Show 15M Context", group=grpV)
show5m         = input.bool(true, "Show 5M Context", group=grpV)
showChildren   = input.bool(true, "Show Child Context Zones", group=grpV)
showStoryLabel = input.bool(false, "Show Floating Story Label", group=grpV)
compactLabels  = input.bool(true, "Compact Child Labels", group=grpV)
futureBars     = input.int(50, "Right Label Offset", minval=10, maxval=250, group=grpV)
theme          = input.string("Light", "Theme", options=["Light", "Dark"], group=grpV)
panelPos       = input.string("Top Right", "Panel Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grpV)
panelMode      = input.string("Mobile", "Panel Mode", options=["Mobile", "Normal", "Debug"], group=grpV)

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────────────
isLight = theme == "Light"
txtCol = isLight ? color.black : color.white
headBg = isLight ? color.new(color.silver, 10) : color.new(color.black, 0)
rowBg  = isLight ? color.new(color.white, 74) : color.new(color.gray, 86)
altBg  = isLight ? color.new(color.silver, 86) : color.new(color.gray, 90)

f_pos(string p) => p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : position.top_right
f_price(float x) => na(x) ? "n/a" : str.tostring(x, format.mintick)
f_rightTime(int barsForward) => time + timeframe.in_seconds(timeframe.period) * 1000 * barsForward
f_body(float o, float c) => math.abs(c - o)
f_rng(float h, float l) => math.max(h - l, syminfo.mintick)
f_bodyRatio(float o, float h, float l, float c) => f_body(o, c) / f_rng(h, l)
f_strDir(int b) => b == 1 ? "Demand" : b == -1 ? "Supply" : "Range"

// NCI no-base / special wick zone builder alpha.
f_supplyBottom(float o, float h, float l, float c) =>
    body = math.max(f_body(o, c), syminfo.mintick)
    upperWick = h - math.max(o, c)
    br = f_bodyRatio(o, h, l, c)
    hugeWick = upperWick >= body * wickBodyRatio
    hugeBody = br >= hugeBodyRatio
    hugeWick ? h - upperWick * 0.50 : hugeBody ? math.max(o, c) : math.min(o, c)

f_demandTop(float o, float h, float l, float c) =>
    body = math.max(f_body(o, c), syminfo.mintick)
    lowerWick = math.min(o, c) - l
    br = f_bodyRatio(o, h, l, c)
    hugeWick = lowerWick >= body * wickBodyRatio
    hugeBody = br >= hugeBodyRatio
    hugeWick ? l + lowerWick * 0.50 : hugeBody ? math.min(o, c) : math.max(o, c)

f_fixSupplyBottom(float top, float bottom, float atr) => math.min(bottom, top - atr * minZoneAtr)
f_fixDemandTop(float bottom, float top, float atr) => math.max(top, bottom + atr * minZoneAtr)

// Reaction score from candles after the pivot/KL candle.
// Pivot/KL candle is [swingLen]. The next candles are [swingLen-1], [swingLen-2], [swingLen-3], [swingLen-4].
f_bullReactionScore(float zoneTop, float zoneBot, float atr) =>
    c1Bull = close[swingLen - 1] > open[swingLen - 1]
    c2Bull = close[swingLen - 2] > open[swingLen - 2]
    c3Bull = close[swingLen - 3] > open[swingLen - 3]
    c4Bull = close[swingLen - 4] > open[swingLen - 4]
    dirScore = (c1Bull ? 1 : 0) + (c2Bull ? 1 : 0) + (c3Bull ? 1 : 0) + (reactionBars >= 4 and c4Bull ? 1 : 0)
    bodyScore = (f_bodyRatio(open[swingLen - 1], high[swingLen - 1], low[swingLen - 1], close[swingLen - 1]) >= 0.50 ? 1 : 0) + (f_bodyRatio(open[swingLen - 2], high[swingLen - 2], low[swingLen - 2], close[swingLen - 2]) >= 0.50 ? 1 : 0) + (f_bodyRatio(open[swingLen - 3], high[swingLen - 3], low[swingLen - 3], close[swingLen - 3]) >= 0.50 ? 1 : 0) + (reactionBars >= 4 and f_bodyRatio(open[swingLen - 4], high[swingLen - 4], low[swingLen - 4], close[swingLen - 4]) >= 0.50 ? 1 : 0)
    awayScore = close[swingLen - 1] > zoneTop or close[swingLen - 2] > zoneTop or close[swingLen - 3] > zoneTop or (reactionBars >= 4 and close[swingLen - 4] > zoneTop) ? 1 : 0
    progressScore = close[swingLen - 1] > close[swingLen] and close[swingLen - 2] >= close[swingLen - 1] ? 1 : 0
    noDeepReentry = math.min(math.min(low[swingLen - 1], low[swingLen - 2]), low[swingLen - 3]) >= zoneBot - atr * reentryAtr ? 1 : 0
    math.min(5, (dirScore >= math.max(2, reactionBars - 1) ? 1 : 0) + (bodyScore >= math.max(1, reactionBars - 1) ? 1 : 0) + awayScore + progressScore + noDeepReentry)

f_bearReactionScore(float zoneTop, float zoneBot, float atr) =>
    c1Bear = close[swingLen - 1] < open[swingLen - 1]
    c2Bear = close[swingLen - 2] < open[swingLen - 2]
    c3Bear = close[swingLen - 3] < open[swingLen - 3]
    c4Bear = close[swingLen - 4] < open[swingLen - 4]
    dirScore = (c1Bear ? 1 : 0) + (c2Bear ? 1 : 0) + (c3Bear ? 1 : 0) + (reactionBars >= 4 and c4Bear ? 1 : 0)
    bodyScore = (f_bodyRatio(open[swingLen - 1], high[swingLen - 1], low[swingLen - 1], close[swingLen - 1]) >= 0.50 ? 1 : 0) + (f_bodyRatio(open[swingLen - 2], high[swingLen - 2], low[swingLen - 2], close[swingLen - 2]) >= 0.50 ? 1 : 0) + (f_bodyRatio(open[swingLen - 3], high[swingLen - 3], low[swingLen - 3], close[swingLen - 3]) >= 0.50 ? 1 : 0) + (reactionBars >= 4 and f_bodyRatio(open[swingLen - 4], high[swingLen - 4], low[swingLen - 4], close[swingLen - 4]) >= 0.50 ? 1 : 0)
    awayScore = close[swingLen - 1] < zoneBot or close[swingLen - 2] < zoneBot or close[swingLen - 3] < zoneBot or (reactionBars >= 4 and close[swingLen - 4] < zoneBot) ? 1 : 0
    progressScore = close[swingLen - 1] < close[swingLen] and close[swingLen - 2] <= close[swingLen - 1] ? 1 : 0
    noDeepReentry = math.max(math.max(high[swingLen - 1], high[swingLen - 2]), high[swingLen - 3]) <= zoneTop + atr * reentryAtr ? 1 : 0
    math.min(5, (dirScore >= math.max(2, reactionBars - 1) ? 1 : 0) + (bodyScore >= math.max(1, reactionBars - 1) ? 1 : 0) + awayScore + progressScore + noDeepReentry)

f_inside(float top, float bot) => not na(top) and not na(bot) and close <= top and close >= bot

// ─────────────────────────────────────────────────────────────────────────────
// State per timeframe
// Return: supplyTop, supplyBot, supplyTime, demandTop, demandBot, demandTime, bias, story, atr, ruleText, insideSupply, insideDemand, supplyScore, demandScore
// ─────────────────────────────────────────────────────────────────────────────
f_state() =>
    atr = ta.atr(atrLen)
    ph = ta.pivothigh(high, swingLen, swingLen)
    pl = ta.pivotlow(low, swingLen, swingLen)

    ph0 = ta.valuewhen(not na(ph), ph, 0)
    ph1 = ta.valuewhen(not na(ph), ph, 1)
    ph2 = ta.valuewhen(not na(ph), ph, 2)
    ph3 = ta.valuewhen(not na(ph), ph, 3)
    ph4 = ta.valuewhen(not na(ph), ph, 4)
    ph5 = ta.valuewhen(not na(ph), ph, 5)
    ph6 = ta.valuewhen(not na(ph), ph, 6)
    ph7 = ta.valuewhen(not na(ph), ph, 7)
    pl0 = ta.valuewhen(not na(pl), pl, 0)
    pl1 = ta.valuewhen(not na(pl), pl, 1)
    pl2 = ta.valuewhen(not na(pl), pl, 2)
    pl3 = ta.valuewhen(not na(pl), pl, 3)
    pl4 = ta.valuewhen(not na(pl), pl, 4)
    pl5 = ta.valuewhen(not na(pl), pl, 5)
    pl6 = ta.valuewhen(not na(pl), pl, 6)
    pl7 = ta.valuewhen(not na(pl), pl, 7)

    phT0 = ta.valuewhen(not na(ph), time[swingLen], 0)
    phT1 = ta.valuewhen(not na(ph), time[swingLen], 1)
    phT2 = ta.valuewhen(not na(ph), time[swingLen], 2)
    phT3 = ta.valuewhen(not na(ph), time[swingLen], 3)
    phT4 = ta.valuewhen(not na(ph), time[swingLen], 4)
    phT5 = ta.valuewhen(not na(ph), time[swingLen], 5)
    phT6 = ta.valuewhen(not na(ph), time[swingLen], 6)
    phT7 = ta.valuewhen(not na(ph), time[swingLen], 7)
    plT0 = ta.valuewhen(not na(pl), time[swingLen], 0)
    plT1 = ta.valuewhen(not na(pl), time[swingLen], 1)
    plT2 = ta.valuewhen(not na(pl), time[swingLen], 2)
    plT3 = ta.valuewhen(not na(pl), time[swingLen], 3)
    plT4 = ta.valuewhen(not na(pl), time[swingLen], 4)
    plT5 = ta.valuewhen(not na(pl), time[swingLen], 5)
    plT6 = ta.valuewhen(not na(pl), time[swingLen], 6)
    plT7 = ta.valuewhen(not na(pl), time[swingLen], 7)

    phO0 = ta.valuewhen(not na(ph), open[swingLen], 0)
    phO1 = ta.valuewhen(not na(ph), open[swingLen], 1)
    phO2 = ta.valuewhen(not na(ph), open[swingLen], 2)
    phO3 = ta.valuewhen(not na(ph), open[swingLen], 3)
    phO4 = ta.valuewhen(not na(ph), open[swingLen], 4)
    phO5 = ta.valuewhen(not na(ph), open[swingLen], 5)
    phO6 = ta.valuewhen(not na(ph), open[swingLen], 6)
    phO7 = ta.valuewhen(not na(ph), open[swingLen], 7)
    phL0 = ta.valuewhen(not na(ph), low[swingLen], 0)
    phL1 = ta.valuewhen(not na(ph), low[swingLen], 1)
    phL2 = ta.valuewhen(not na(ph), low[swingLen], 2)
    phL3 = ta.valuewhen(not na(ph), low[swingLen], 3)
    phL4 = ta.valuewhen(not na(ph), low[swingLen], 4)
    phL5 = ta.valuewhen(not na(ph), low[swingLen], 5)
    phL6 = ta.valuewhen(not na(ph), low[swingLen], 6)
    phL7 = ta.valuewhen(not na(ph), low[swingLen], 7)
    phC0 = ta.valuewhen(not na(ph), close[swingLen], 0)
    phC1 = ta.valuewhen(not na(ph), close[swingLen], 1)
    phC2 = ta.valuewhen(not na(ph), close[swingLen], 2)
    phC3 = ta.valuewhen(not na(ph), close[swingLen], 3)
    phC4 = ta.valuewhen(not na(ph), close[swingLen], 4)
    phC5 = ta.valuewhen(not na(ph), close[swingLen], 5)
    phC6 = ta.valuewhen(not na(ph), close[swingLen], 6)
    phC7 = ta.valuewhen(not na(ph), close[swingLen], 7)

    plO0 = ta.valuewhen(not na(pl), open[swingLen], 0)
    plO1 = ta.valuewhen(not na(pl), open[swingLen], 1)
    plO2 = ta.valuewhen(not na(pl), open[swingLen], 2)
    plO3 = ta.valuewhen(not na(pl), open[swingLen], 3)
    plO4 = ta.valuewhen(not na(pl), open[swingLen], 4)
    plO5 = ta.valuewhen(not na(pl), open[swingLen], 5)
    plO6 = ta.valuewhen(not na(pl), open[swingLen], 6)
    plO7 = ta.valuewhen(not na(pl), open[swingLen], 7)
    plH0 = ta.valuewhen(not na(pl), high[swingLen], 0)
    plH1 = ta.valuewhen(not na(pl), high[swingLen], 1)
    plH2 = ta.valuewhen(not na(pl), high[swingLen], 2)
    plH3 = ta.valuewhen(not na(pl), high[swingLen], 3)
    plH4 = ta.valuewhen(not na(pl), high[swingLen], 4)
    plH5 = ta.valuewhen(not na(pl), high[swingLen], 5)
    plH6 = ta.valuewhen(not na(pl), high[swingLen], 6)
    plH7 = ta.valuewhen(not na(pl), high[swingLen], 7)
    plC0 = ta.valuewhen(not na(pl), close[swingLen], 0)
    plC1 = ta.valuewhen(not na(pl), close[swingLen], 1)
    plC2 = ta.valuewhen(not na(pl), close[swingLen], 2)
    plC3 = ta.valuewhen(not na(pl), close[swingLen], 3)
    plC4 = ta.valuewhen(not na(pl), close[swingLen], 4)
    plC5 = ta.valuewhen(not na(pl), close[swingLen], 5)
    plC6 = ta.valuewhen(not na(pl), close[swingLen], 6)
    plC7 = ta.valuewhen(not na(pl), close[swingLen], 7)

    sb0 = f_fixSupplyBottom(ph0, f_supplyBottom(phO0, ph0, phL0, phC0), atr)
    sb1 = f_fixSupplyBottom(ph1, f_supplyBottom(phO1, ph1, phL1, phC1), atr)
    sb2 = f_fixSupplyBottom(ph2, f_supplyBottom(phO2, ph2, phL2, phC2), atr)
    sb3 = f_fixSupplyBottom(ph3, f_supplyBottom(phO3, ph3, phL3, phC3), atr)
    sb4 = f_fixSupplyBottom(ph4, f_supplyBottom(phO4, ph4, phL4, phC4), atr)
    sb5 = f_fixSupplyBottom(ph5, f_supplyBottom(phO5, ph5, phL5, phC5), atr)
    sb6 = f_fixSupplyBottom(ph6, f_supplyBottom(phO6, ph6, phL6, phC6), atr)
    sb7 = f_fixSupplyBottom(ph7, f_supplyBottom(phO7, ph7, phL7, phC7), atr)

    dt0 = f_fixDemandTop(pl0, f_demandTop(plO0, plH0, pl0, plC0), atr)
    dt1 = f_fixDemandTop(pl1, f_demandTop(plO1, plH1, pl1, plC1), atr)
    dt2 = f_fixDemandTop(pl2, f_demandTop(plO2, plH2, pl2, plC2), atr)
    dt3 = f_fixDemandTop(pl3, f_demandTop(plO3, plH3, pl3, plC3), atr)
    dt4 = f_fixDemandTop(pl4, f_demandTop(plO4, plH4, pl4, plC4), atr)
    dt5 = f_fixDemandTop(pl5, f_demandTop(plO5, plH5, pl5, plC5), atr)
    dt6 = f_fixDemandTop(pl6, f_demandTop(plO6, plH6, pl6, plC6), atr)
    dt7 = f_fixDemandTop(pl7, f_demandTop(plO7, plH7, pl7, plC7), atr)

    dScoreNow = not na(pl) ? f_bullReactionScore(dt0, pl0, atr) : 0
    sScoreNow = not na(ph) ? f_bearReactionScore(ph0, sb0, atr) : 0
    dReact0 = ta.valuewhen(not na(pl), dScoreNow, 0)
    dReact1 = ta.valuewhen(not na(pl), dScoreNow, 1)
    dReact2 = ta.valuewhen(not na(pl), dScoreNow, 2)
    dReact3 = ta.valuewhen(not na(pl), dScoreNow, 3)
    dReact4 = ta.valuewhen(not na(pl), dScoreNow, 4)
    dReact5 = ta.valuewhen(not na(pl), dScoreNow, 5)
    dReact6 = ta.valuewhen(not na(pl), dScoreNow, 6)
    dReact7 = ta.valuewhen(not na(pl), dScoreNow, 7)
    sReact0 = ta.valuewhen(not na(ph), sScoreNow, 0)
    sReact1 = ta.valuewhen(not na(ph), sScoreNow, 1)
    sReact2 = ta.valuewhen(not na(ph), sScoreNow, 2)
    sReact3 = ta.valuewhen(not na(ph), sScoreNow, 3)
    sReact4 = ta.valuewhen(not na(ph), sScoreNow, 4)
    sReact5 = ta.valuewhen(not na(ph), sScoreNow, 5)
    sReact6 = ta.valuewhen(not na(ph), sScoreNow, 6)
    sReact7 = ta.valuewhen(not na(ph), sScoreNow, 7)

    bullBreak = not na(ph1) and (bosUseClose ? close > ph1 + atr * bosBufferAtr : high > ph1 + atr * bosBufferAtr)
    bearBreak = not na(pl1) and (bosUseClose ? close < pl1 - atr * bosBufferAtr : low < pl1 - atr * bosBufferAtr)
    dReactOk = not requireReaction or dReact0 >= minReactionScore
    sReactOk = not requireReaction or sReact0 >= minReactionScore
    validBullBreak = bullBreak and dReactOk
    validBearBreak = bearBreak and sReactOk

    bosDTop0 = ta.valuewhen(validBullBreak, dt0, 0)
    bosDTop1 = ta.valuewhen(validBullBreak, dt0, 1)
    bosDTop2 = ta.valuewhen(validBullBreak, dt0, 2)
    bosDTop3 = ta.valuewhen(validBullBreak, dt0, 3)
    bosDTop4 = ta.valuewhen(validBullBreak, dt0, 4)
    bosDTop5 = ta.valuewhen(validBullBreak, dt0, 5)
    bosDTop6 = ta.valuewhen(validBullBreak, dt0, 6)
    bosDTop7 = ta.valuewhen(validBullBreak, dt0, 7)
    bosDBot0 = ta.valuewhen(validBullBreak, pl0, 0)
    bosDBot1 = ta.valuewhen(validBullBreak, pl0, 1)
    bosDBot2 = ta.valuewhen(validBullBreak, pl0, 2)
    bosDBot3 = ta.valuewhen(validBullBreak, pl0, 3)
    bosDBot4 = ta.valuewhen(validBullBreak, pl0, 4)
    bosDBot5 = ta.valuewhen(validBullBreak, pl0, 5)
    bosDBot6 = ta.valuewhen(validBullBreak, pl0, 6)
    bosDBot7 = ta.valuewhen(validBullBreak, pl0, 7)
    bosDTime0 = ta.valuewhen(validBullBreak, plT0, 0)
    bosDTime1 = ta.valuewhen(validBullBreak, plT0, 1)
    bosDTime2 = ta.valuewhen(validBullBreak, plT0, 2)
    bosDTime3 = ta.valuewhen(validBullBreak, plT0, 3)
    bosDTime4 = ta.valuewhen(validBullBreak, plT0, 4)
    bosDTime5 = ta.valuewhen(validBullBreak, plT0, 5)
    bosDTime6 = ta.valuewhen(validBullBreak, plT0, 6)
    bosDTime7 = ta.valuewhen(validBullBreak, plT0, 7)
    bosDScore0 = ta.valuewhen(validBullBreak, dReact0, 0)
    bosDScore1 = ta.valuewhen(validBullBreak, dReact0, 1)
    bosDScore2 = ta.valuewhen(validBullBreak, dReact0, 2)
    bosDScore3 = ta.valuewhen(validBullBreak, dReact0, 3)
    bosDScore4 = ta.valuewhen(validBullBreak, dReact0, 4)
    bosDScore5 = ta.valuewhen(validBullBreak, dReact0, 5)
    bosDScore6 = ta.valuewhen(validBullBreak, dReact0, 6)
    bosDScore7 = ta.valuewhen(validBullBreak, dReact0, 7)

    bosSTop0 = ta.valuewhen(validBearBreak, ph0, 0)
    bosSTop1 = ta.valuewhen(validBearBreak, ph0, 1)
    bosSTop2 = ta.valuewhen(validBearBreak, ph0, 2)
    bosSTop3 = ta.valuewhen(validBearBreak, ph0, 3)
    bosSTop4 = ta.valuewhen(validBearBreak, ph0, 4)
    bosSTop5 = ta.valuewhen(validBearBreak, ph0, 5)
    bosSTop6 = ta.valuewhen(validBearBreak, ph0, 6)
    bosSTop7 = ta.valuewhen(validBearBreak, ph0, 7)
    bosSBot0 = ta.valuewhen(validBearBreak, sb0, 0)
    bosSBot1 = ta.valuewhen(validBearBreak, sb0, 1)
    bosSBot2 = ta.valuewhen(validBearBreak, sb0, 2)
    bosSBot3 = ta.valuewhen(validBearBreak, sb0, 3)
    bosSBot4 = ta.valuewhen(validBearBreak, sb0, 4)
    bosSBot5 = ta.valuewhen(validBearBreak, sb0, 5)
    bosSBot6 = ta.valuewhen(validBearBreak, sb0, 6)
    bosSBot7 = ta.valuewhen(validBearBreak, sb0, 7)
    bosSTime0 = ta.valuewhen(validBearBreak, phT0, 0)
    bosSTime1 = ta.valuewhen(validBearBreak, phT0, 1)
    bosSTime2 = ta.valuewhen(validBearBreak, phT0, 2)
    bosSTime3 = ta.valuewhen(validBearBreak, phT0, 3)
    bosSTime4 = ta.valuewhen(validBearBreak, phT0, 4)
    bosSTime5 = ta.valuewhen(validBearBreak, phT0, 5)
    bosSTime6 = ta.valuewhen(validBearBreak, phT0, 6)
    bosSTime7 = ta.valuewhen(validBearBreak, phT0, 7)
    bosSScore0 = ta.valuewhen(validBearBreak, sReact0, 0)
    bosSScore1 = ta.valuewhen(validBearBreak, sReact0, 1)
    bosSScore2 = ta.valuewhen(validBearBreak, sReact0, 2)
    bosSScore3 = ta.valuewhen(validBearBreak, sReact0, 3)
    bosSScore4 = ta.valuewhen(validBearBreak, sReact0, 4)
    bosSScore5 = ta.valuewhen(validBearBreak, sReact0, 5)
    bosSScore6 = ta.valuewhen(validBearBreak, sReact0, 6)
    bosSScore7 = ta.valuewhen(validBearBreak, sReact0, 7)

    rawS0ok = searchDepth > 0 and not na(ph0) and (not requireReaction or sReact0 >= minReactionScore) and close <= ph0 + atr * mitigateAtr
    rawS1ok = searchDepth > 1 and not na(ph1) and (not requireReaction or sReact1 >= minReactionScore) and close <= ph1 + atr * mitigateAtr
    rawS2ok = searchDepth > 2 and not na(ph2) and (not requireReaction or sReact2 >= minReactionScore) and close <= ph2 + atr * mitigateAtr
    rawS3ok = searchDepth > 3 and not na(ph3) and (not requireReaction or sReact3 >= minReactionScore) and close <= ph3 + atr * mitigateAtr
    rawS4ok = searchDepth > 4 and not na(ph4) and (not requireReaction or sReact4 >= minReactionScore) and close <= ph4 + atr * mitigateAtr
    rawS5ok = searchDepth > 5 and not na(ph5) and (not requireReaction or sReact5 >= minReactionScore) and close <= ph5 + atr * mitigateAtr
    rawS6ok = searchDepth > 6 and not na(ph6) and (not requireReaction or sReact6 >= minReactionScore) and close <= ph6 + atr * mitigateAtr
    rawS7ok = searchDepth > 7 and not na(ph7) and (not requireReaction or sReact7 >= minReactionScore) and close <= ph7 + atr * mitigateAtr
    rawD0ok = searchDepth > 0 and not na(pl0) and (not requireReaction or dReact0 >= minReactionScore) and close >= pl0 - atr * mitigateAtr
    rawD1ok = searchDepth > 1 and not na(pl1) and (not requireReaction or dReact1 >= minReactionScore) and close >= pl1 - atr * mitigateAtr
    rawD2ok = searchDepth > 2 and not na(pl2) and (not requireReaction or dReact2 >= minReactionScore) and close >= pl2 - atr * mitigateAtr
    rawD3ok = searchDepth > 3 and not na(pl3) and (not requireReaction or dReact3 >= minReactionScore) and close >= pl3 - atr * mitigateAtr
    rawD4ok = searchDepth > 4 and not na(pl4) and (not requireReaction or dReact4 >= minReactionScore) and close >= pl4 - atr * mitigateAtr
    rawD5ok = searchDepth > 5 and not na(pl5) and (not requireReaction or dReact5 >= minReactionScore) and close >= pl5 - atr * mitigateAtr
    rawD6ok = searchDepth > 6 and not na(pl6) and (not requireReaction or dReact6 >= minReactionScore) and close >= pl6 - atr * mitigateAtr
    rawD7ok = searchDepth > 7 and not na(pl7) and (not requireReaction or dReact7 >= minReactionScore) and close >= pl7 - atr * mitigateAtr

    bosS0ok = searchDepth > 0 and not na(bosSTop0) and close <= bosSTop0 + atr * mitigateAtr
    bosS1ok = searchDepth > 1 and not na(bosSTop1) and close <= bosSTop1 + atr * mitigateAtr
    bosS2ok = searchDepth > 2 and not na(bosSTop2) and close <= bosSTop2 + atr * mitigateAtr
    bosS3ok = searchDepth > 3 and not na(bosSTop3) and close <= bosSTop3 + atr * mitigateAtr
    bosS4ok = searchDepth > 4 and not na(bosSTop4) and close <= bosSTop4 + atr * mitigateAtr
    bosS5ok = searchDepth > 5 and not na(bosSTop5) and close <= bosSTop5 + atr * mitigateAtr
    bosS6ok = searchDepth > 6 and not na(bosSTop6) and close <= bosSTop6 + atr * mitigateAtr
    bosS7ok = searchDepth > 7 and not na(bosSTop7) and close <= bosSTop7 + atr * mitigateAtr
    bosD0ok = searchDepth > 0 and not na(bosDBot0) and close >= bosDBot0 - atr * mitigateAtr
    bosD1ok = searchDepth > 1 and not na(bosDBot1) and close >= bosDBot1 - atr * mitigateAtr
    bosD2ok = searchDepth > 2 and not na(bosDBot2) and close >= bosDBot2 - atr * mitigateAtr
    bosD3ok = searchDepth > 3 and not na(bosDBot3) and close >= bosDBot3 - atr * mitigateAtr
    bosD4ok = searchDepth > 4 and not na(bosDBot4) and close >= bosDBot4 - atr * mitigateAtr
    bosD5ok = searchDepth > 5 and not na(bosDBot5) and close >= bosDBot5 - atr * mitigateAtr
    bosD6ok = searchDepth > 6 and not na(bosDBot6) and close >= bosDBot6 - atr * mitigateAtr
    bosD7ok = searchDepth > 7 and not na(bosDBot7) and close >= bosDBot7 - atr * mitigateAtr

    rawSupplyTop = rawS0ok ? ph0 : rawS1ok ? ph1 : rawS2ok ? ph2 : rawS3ok ? ph3 : rawS4ok ? ph4 : rawS5ok ? ph5 : rawS6ok ? ph6 : rawS7ok ? ph7 : na
    rawSupplyBot = rawS0ok ? sb0 : rawS1ok ? sb1 : rawS2ok ? sb2 : rawS3ok ? sb3 : rawS4ok ? sb4 : rawS5ok ? sb5 : rawS6ok ? sb6 : rawS7ok ? sb7 : na
    rawSupplyTime = rawS0ok ? phT0 : rawS1ok ? phT1 : rawS2ok ? phT2 : rawS3ok ? phT3 : rawS4ok ? phT4 : rawS5ok ? phT5 : rawS6ok ? phT6 : rawS7ok ? phT7 : na
    rawSupplyScore = rawS0ok ? sReact0 : rawS1ok ? sReact1 : rawS2ok ? sReact2 : rawS3ok ? sReact3 : rawS4ok ? sReact4 : rawS5ok ? sReact5 : rawS6ok ? sReact6 : rawS7ok ? sReact7 : 0
    rawDemandBot = rawD0ok ? pl0 : rawD1ok ? pl1 : rawD2ok ? pl2 : rawD3ok ? pl3 : rawD4ok ? pl4 : rawD5ok ? pl5 : rawD6ok ? pl6 : rawD7ok ? pl7 : na
    rawDemandTop = rawD0ok ? dt0 : rawD1ok ? dt1 : rawD2ok ? dt2 : rawD3ok ? dt3 : rawD4ok ? dt4 : rawD5ok ? dt5 : rawD6ok ? dt6 : rawD7ok ? dt7 : na
    rawDemandTime = rawD0ok ? plT0 : rawD1ok ? plT1 : rawD2ok ? plT2 : rawD3ok ? plT3 : rawD4ok ? plT4 : rawD5ok ? plT5 : rawD6ok ? plT6 : rawD7ok ? plT7 : na
    rawDemandScore = rawD0ok ? dReact0 : rawD1ok ? dReact1 : rawD2ok ? dReact2 : rawD3ok ? dReact3 : rawD4ok ? dReact4 : rawD5ok ? dReact5 : rawD6ok ? dReact6 : rawD7ok ? dReact7 : 0

    bosSupplyTop = bosS0ok ? bosSTop0 : bosS1ok ? bosSTop1 : bosS2ok ? bosSTop2 : bosS3ok ? bosSTop3 : bosS4ok ? bosSTop4 : bosS5ok ? bosSTop5 : bosS6ok ? bosSTop6 : bosS7ok ? bosSTop7 : rawSupplyTop
    bosSupplyBot = bosS0ok ? bosSBot0 : bosS1ok ? bosSBot1 : bosS2ok ? bosSBot2 : bosS3ok ? bosSBot3 : bosS4ok ? bosSBot4 : bosS5ok ? bosSBot5 : bosS6ok ? bosSBot6 : bosS7ok ? bosSBot7 : rawSupplyBot
    bosSupplyTime = bosS0ok ? bosSTime0 : bosS1ok ? bosSTime1 : bosS2ok ? bosSTime2 : bosS3ok ? bosSTime3 : bosS4ok ? bosSTime4 : bosS5ok ? bosSTime5 : bosS6ok ? bosSTime6 : bosS7ok ? bosSTime7 : rawSupplyTime
    bosSupplyScore = bosS0ok ? bosSScore0 : bosS1ok ? bosSScore1 : bosS2ok ? bosSScore2 : bosS3ok ? bosSScore3 : bosS4ok ? bosSScore4 : bosS5ok ? bosSScore5 : bosS6ok ? bosSScore6 : bosS7ok ? bosSScore7 : rawSupplyScore
    bosDemandBot = bosD0ok ? bosDBot0 : bosD1ok ? bosDBot1 : bosD2ok ? bosDBot2 : bosD3ok ? bosDBot3 : bosD4ok ? bosDBot4 : bosD5ok ? bosDBot5 : bosD6ok ? bosDBot6 : bosD7ok ? bosDBot7 : rawDemandBot
    bosDemandTop = bosD0ok ? bosDTop0 : bosD1ok ? bosDTop1 : bosD2ok ? bosDTop2 : bosD3ok ? bosDTop3 : bosD4ok ? bosDTop4 : bosD5ok ? bosDTop5 : bosD6ok ? bosDTop6 : bosD7ok ? bosDTop7 : rawDemandTop
    bosDemandTime = bosD0ok ? bosDTime0 : bosD1ok ? bosDTime1 : bosD2ok ? bosDTime2 : bosD3ok ? bosDTime3 : bosD4ok ? bosDTime4 : bosD5ok ? bosDTime5 : bosD6ok ? bosDTime6 : bosD7ok ? bosDTime7 : rawDemandTime
    bosDemandScore = bosD0ok ? bosDScore0 : bosD1ok ? bosDScore1 : bosD2ok ? bosDScore2 : bosD3ok ? bosDScore3 : bosD4ok ? bosDScore4 : bosD5ok ? bosDScore5 : bosD6ok ? bosDScore6 : bosD7ok ? bosDScore7 : rawDemandScore

    supplyTop = requireBOS ? bosSupplyTop : rawSupplyTop
    supplyBot = requireBOS ? bosSupplyBot : rawSupplyBot
    supplyTime = requireBOS ? bosSupplyTime : rawSupplyTime
    supplyScore = requireBOS ? bosSupplyScore : rawSupplyScore
    demandBot = requireBOS ? bosDemandBot : rawDemandBot
    demandTop = requireBOS ? bosDemandTop : rawDemandTop
    demandTime = requireBOS ? bosDemandTime : rawDemandTime
    demandScore = requireBOS ? bosDemandScore : rawDemandScore

    inSupply = f_inside(supplyTop, supplyBot)
    inDemand = f_inside(demandTop, demandBot)
    hasBoth = not na(supplyTop) and not na(demandBot)
    mid = hasBoth ? (supplyBot + demandTop) / 2.0 : close
    int bias = not hasBoth ? 0 : insideZoneFilter and inSupply ? 0 : insideZoneFilter and inDemand ? 0 : close > supplyTop ? 1 : close < demandBot ? -1 : close >= mid ? -1 : 1
    string story = not hasBoth ? "Building KL memory" : inSupply ? "Inside supply decision — wait reject/break" : inDemand ? "Inside demand decision — wait react/break" : bias == 1 ? "Working above demand; watching supply" : bias == -1 ? "Working below supply; watching demand" : "Inside active KL range"
    string ruleText = (requireBOS ? "BOS" : "No BOS") + " + " + (requireReaction ? "Reaction" : "No reaction")
    [supplyTop, supplyBot, supplyTime, demandTop, demandBot, demandTime, bias, story, atr, ruleText, inSupply, inDemand, supplyScore, demandScore]

[s4Top, s4Bot, s4Time, d4Top, d4Bot, d4Time, b4, story4, atr4, rule4, inS4, inD4, sScore4, dScore4] = request.security(syminfo.tickerid, tf4h, f_state())
[s1Top, s1Bot, s1Time, d1Top, d1Bot, d1Time, b1, story1, atr1, rule1, inS1, inD1, sScore1, dScore1] = request.security(syminfo.tickerid, tf1h, f_state())
[s15Top, s15Bot, s15Time, d15Top, d15Bot, d15Time, b15, story15, atr15, rule15, inS15, inD15, sScore15, dScore15] = request.security(syminfo.tickerid, tf15m, f_state())
[s5Top, s5Bot, s5Time, d5Top, d5Bot, d5Time, b5, story5, atr5, rule5, inS5, inD5, sScore5, dScore5] = request.security(syminfo.tickerid, tf5m, f_state())

role1 = inS1 or inD1 ? "1H decision zone — wait" : b1 == b4 ? "1H explains 4H" : b1 == 0 ? "1H building" : "1H pullback against 4H"
role15 = inS15 or inD15 ? "15M decision zone — wait" : b15 == b1 ? "15M explains 1H" : b15 == 0 ? "15M building" : "15M counter-move"
role5 = inS5 or inD5 ? "5M decision zone — wait trigger" : b5 == b15 ? "5M aligned — wait trigger" : b5 == 0 ? "5M building" : "5M local reaction"
finalStory = inS4 ? "4H SUPPLY DECISION ACTIVE" : inD4 ? "4H DEMAND DECISION ACTIVE" : b4 == 1 ? "4H DEMAND STORY ACTIVE" : b4 == -1 ? "4H SUPPLY STORY ACTIVE" : "4H RANGE / WAIT"
confidence = requireBOS and requireReaction ? "BOS + reaction validated" : requireBOS ? "BOS validated; reaction optional" : requireReaction ? "Reaction validated; BOS optional" : "Loose KL mode"

// ─────────────────────────────────────────────────────────────────────────────
// Panel
// ─────────────────────────────────────────────────────────────────────────────
var table panel = table.new(f_pos(panelPos), 2, 16, border_width=1)
f_cell(int c, int r, string s, color bg) => table.cell(panel, c, r, s, bgcolor=bg, text_color=txtCol, text_size=panelMode == "Mobile" ? size.tiny : size.small)

if barstate.islast and showPanel
    table.clear(panel, 0, 0, 1, 15)
    f_cell(0, 0, "NCI x SMC", headBg)
    f_cell(1, 0, "v1.4.4", headBg)
    f_cell(0, 1, "Final", altBg)
    f_cell(1, 1, finalStory, altBg)
    f_cell(0, 2, "Confidence", rowBg)
    f_cell(1, 2, confidence, rowBg)
    f_cell(0, 3, "4H Master", rowBg)
    f_cell(1, 3, story4, rowBg)
    f_cell(0, 4, "KL Rule", rowBg)
    f_cell(1, 4, rule4, rowBg)
    f_cell(0, 5, "1H Role", rowBg)
    f_cell(1, 5, role1, rowBg)
    f_cell(0, 6, "15M Role", rowBg)
    f_cell(1, 6, role15, rowBg)
    f_cell(0, 7, "5M Role", rowBg)
    f_cell(1, 7, role5, rowBg)
    f_cell(0, 8, "4H Supply", rowBg)
    f_cell(1, 8, f_price(s4Bot) + " - " + f_price(s4Top) + " | S" + str.tostring(sScore4), rowBg)
    f_cell(0, 9, "4H Demand", rowBg)
    f_cell(1, 9, f_price(d4Bot) + " - " + f_price(d4Top) + " | S" + str.tostring(dScore4), rowBg)
    if panelMode == "Debug"
        f_cell(0, 10, "1H", rowBg)
        f_cell(1, 10, story1, rowBg)
        f_cell(0, 11, "15M", rowBg)
        f_cell(1, 11, story15, rowBg)
        f_cell(0, 12, "5M", rowBg)
        f_cell(1, 12, story5, rowBg)

// ─────────────────────────────────────────────────────────────────────────────
// Visuals
// ─────────────────────────────────────────────────────────────────────────────
var box bs4 = na
var box bd4 = na
var box bs1 = na
var box bd1 = na
var box bs15 = na
var box bd15 = na
var box bs5 = na
var box bd5 = na
var label ls4 = na
var label ld4 = na
var label ls1 = na
var label ld1 = na
var label ls15 = na
var label ld15 = na
var label ls5 = na
var label ld5 = na
var label stLab = na

f_box(int leftT, float top, float bottom, color col, int transp) =>
    box.new(left=leftT, top=top, right=f_rightTime(futureBars), bottom=bottom, xloc=xloc.bar_time, bgcolor=color.new(col, transp), border_color=color.new(col, 35), extend=extend.right)

f_lab(int off, float y, string s, string tip, color col, bool smallTxt) =>
    label.new(x=f_rightTime(off), y=y, text=s, tooltip=tip, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(col, 78), textcolor=color.black, size=smallTxt ? size.tiny : size.small)

f_tip(string tf, string side, float bot, float top, int score, bool insideNow) =>
    tf + " " + side + "\nZone: " + f_price(bot) + " - " + f_price(top) + "\nReaction score: " + str.tostring(score) + "\nStatus: " + (insideNow ? "inside decision zone; wait" : "outside zone; watch reaction/retest")

if barstate.islast
    box.delete(bs4), box.delete(bd4), box.delete(bs1), box.delete(bd1), box.delete(bs15), box.delete(bd15), box.delete(bs5), box.delete(bd5)
    label.delete(ls4), label.delete(ld4), label.delete(ls1), label.delete(ld1), label.delete(ls15), label.delete(ld15), label.delete(ls5), label.delete(ld5), label.delete(stLab)

    if show4h and not na(s4Time) and not na(s4Top) and not na(s4Bot)
        bs4 := f_box(s4Time, s4Top, s4Bot, color.fuchsia, 88)
        ls4 := f_lab(futureBars, (s4Top + s4Bot) / 2, "4H SUPPLY\n" + f_price(s4Bot) + " - " + f_price(s4Top), f_tip("4H", "Supply", s4Bot, s4Top, sScore4, inS4), color.fuchsia, false)
    if show4h and not na(d4Time) and not na(d4Top) and not na(d4Bot)
        bd4 := f_box(d4Time, d4Top, d4Bot, color.aqua, 86)
        ld4 := f_lab(futureBars + 8, (d4Top + d4Bot) / 2, "4H DEMAND\n" + f_price(d4Bot) + " - " + f_price(d4Top), f_tip("4H", "Demand", d4Bot, d4Top, dScore4, inD4), color.aqua, false)

    if showChildren and show1h and not na(s1Time) and not na(s1Top) and not na(s1Bot)
        bs1 := f_box(s1Time, s1Top, s1Bot, color.red, 91)
        ls1 := f_lab(futureBars + 16, (s1Top + s1Bot) / 2, compactLabels ? "1H SUP" : "1H SUPPLY", f_tip("1H", "Supply", s1Bot, s1Top, sScore1, inS1), color.red, true)
    if showChildren and show1h and not na(d1Time) and not na(d1Top) and not na(d1Bot)
        bd1 := f_box(d1Time, d1Top, d1Bot, color.teal, 91)
        ld1 := f_lab(futureBars + 24, (d1Top + d1Bot) / 2, compactLabels ? "1H DEM" : "1H DEMAND", f_tip("1H", "Demand", d1Bot, d1Top, dScore1, inD1), color.teal, true)

    if showChildren and show15m and not na(s15Time) and not na(s15Top) and not na(s15Bot)
        bs15 := f_box(s15Time, s15Top, s15Bot, color.orange, 93)
        ls15 := f_lab(futureBars + 32, (s15Top + s15Bot) / 2, compactLabels ? "15M SUP" : "15M SUPPLY", f_tip("15M", "Supply", s15Bot, s15Top, sScore15, inS15), color.orange, true)
    if showChildren and show15m and not na(d15Time) and not na(d15Top) and not na(d15Bot)
        bd15 := f_box(d15Time, d15Top, d15Bot, color.green, 93)
        ld15 := f_lab(futureBars + 40, (d15Top + d15Bot) / 2, compactLabels ? "15M DEM" : "15M DEMAND", f_tip("15M", "Demand", d15Bot, d15Top, dScore15, inD15), color.green, true)

    if showChildren and show5m and not na(s5Time) and not na(s5Top) and not na(s5Bot)
        bs5 := f_box(s5Time, s5Top, s5Bot, color.yellow, 95)
        ls5 := f_lab(futureBars + 48, (s5Top + s5Bot) / 2, compactLabels ? "5M SUP" : "5M SUPPLY", f_tip("5M", "Supply", s5Bot, s5Top, sScore5, inS5), color.yellow, true)
    if showChildren and show5m and not na(d5Time) and not na(d5Top) and not na(d5Bot)
        bd5 := f_box(d5Time, d5Top, d5Bot, color.lime, 95)
        ld5 := f_lab(futureBars + 56, (d5Top + d5Bot) / 2, compactLabels ? "5M DEM" : "5M DEMAND", f_tip("5M", "Demand", d5Bot, d5Top, dScore5, inD5), color.lime, true)

    if showStoryLabel
        stLab := f_lab(futureBars + 10, close, "NCI STORY\n" + finalStory, "Panel has full story. Child labels use tooltip/full panel to reduce mobile noise.", color.gray, false)
